{
  "name": "toolsoftools",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/check-perf-budget.ts",
    "budget": "tsx scripts/check-perf-budget.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=toolsoftools --branch=main",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "audit": "node -e \"process.exit(0)\"",
    "scaffold:content": "tsx scripts/scaffold-content.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^5.4.1",
    "tailwindcss": "^4.0.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.135.0"
  }
}
