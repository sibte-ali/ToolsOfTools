---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHtmlLang } from '../i18n';
import { getHreflang } from '../lib/hreflang';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'Tools of Tools - Fast, Client-Side Free Tools',
  description = 'Fast, accurate, client-side calculations and tools for finance, math, and everyday needs.',
  lang = 'en',
} = Astro.props;

const htmlLang = getHtmlLang(lang);
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? Astro.site.origin : 'https://toolsoftools.com';

const alternates = getHreflang(currentPath, lang);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={`${siteUrl}${alt.url}`} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-50">
    <Header currentUrl={currentPath} lang={lang} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer lang={lang} />
  </body>
</html>
