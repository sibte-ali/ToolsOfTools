---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tools of Tools - Fast, Client-Side Free Tools">
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-neutral-950 dark:text-white">
        Tools of Tools
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-300">
        Fast, privacy-focused calculators, converters, and utilities running directly in your browser.
      </p>
    </div>
  </main>
</Layout>
