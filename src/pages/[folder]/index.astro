---
import HubPage from '../../components/HubPage.astro';
import { getEffectiveHubs, type Tool } from '../../lib/tools';

export function getStaticPaths() {
  const hubs = getEffectiveHubs('en');

  return hubs.map((hub) => ({
    params: { folder: hub.folder },
    props: {
      folder: hub.folder,
      tools: hub.tools,
    },
  }));
}

interface Props {
  folder: string;
  tools: Tool[];
}

const { folder, tools } = Astro.props;
---

<HubPage lang="en" folder={folder} tools={tools} />
