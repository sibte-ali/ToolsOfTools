---
import HubPage from '../../components/HubPage.astro';
import { foldersByLang, toolsByLang, type Tool } from '../../lib/tools';

export function getStaticPaths() {
  const enFolders = foldersByLang('en');
  const enTools = toolsByLang('en');

  return enFolders.map((folder) => ({
    params: { folder },
    props: {
      folder,
      tools: enTools.filter((t) => t.folder === folder),
    },
  }));
}

interface Props {
  folder: string;
  tools: Tool[];
}

const { folder, tools } = Astro.props;
---

<HubPage lang="en" folder={folder} tools={tools} />
