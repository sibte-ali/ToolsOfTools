---
import ToolPage from '../../../components/ToolPage.astro';
import { toolsByLang, type Tool } from '../../../lib/tools';

export function getStaticPaths() {
  const esTools = toolsByLang('es');
  // Exclude 'calculadora' mounted on /es/ homepage
  return esTools
    .filter((tool) => !(tool.slug === 'calculadora' && tool.folder === 'otras-calculadoras'))
    .map((tool) => ({
      params: { folder: tool.folder, slug: tool.slug },
      props: { tool },
    }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<ToolPage lang="es" tool={tool} />
