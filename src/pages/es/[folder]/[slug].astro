---
import ToolPage from '../../../components/ToolPage.astro';
import { toolsByLang, type Tool } from '../../../lib/tools';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const esTools = toolsByLang('es');
  // Exclude 'calculadora' mounted on /es/ homepage
  return Promise.all(
    esTools
      .filter((tool) => !(tool.slug === 'calculadora' && tool.folder === 'otras-calculadoras'))
      .map(async (tool) => {
        const entry = await getEntry('tools', `es/${tool.slug}`);
        return {
          params: { folder: tool.folder, slug: tool.slug },
          props: { tool, entry },
        };
      })
  );
}

interface Props {
  tool: Tool;
  entry?: any;
}

const { tool, entry } = Astro.props;
---

<ToolPage lang="es" tool={tool} entry={entry} />
