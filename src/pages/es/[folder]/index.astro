---
import HubPage from '../../../components/HubPage.astro';
import { foldersByLang, toolsByLang, type Tool } from '../../../lib/tools';

export function getStaticPaths() {
  const esFolders = foldersByLang('es');
  const esTools = toolsByLang('es');

  return esFolders.map((folder) => ({
    params: { folder },
    props: {
      folder,
      tools: esTools.filter((t) => t.folder === folder),
    },
  }));
}

interface Props {
  folder: string;
  tools: Tool[];
}

const { folder, tools } = Astro.props;
---

<HubPage lang="es" folder={folder} tools={tools} />
