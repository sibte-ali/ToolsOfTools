---
import Layout from '../layouts/Layout.astro';
import { toolsByLang, getEffectiveHubs } from '../lib/tools';

const hubs = getEffectiveHubs('en').slice(0, 6);

const popularTools = [
  { name: 'EMI Calculator', url: '/finance/emi-calculator/', icon: '💰', desc: 'Calculate loan EMI, interest, and amortization' },
  { name: 'JSON Beautifier', url: '/json/json-beautifier/', icon: '🗂️', desc: 'Format, validate, and inspect JSON payloads' },
  { name: 'Kruti Dev to Unicode', url: '/font-converters/krutidev-to-unicode/', icon: '🔤', desc: 'Convert Hindi typewriter font to universal Unicode' },
  { name: 'Resize Image', url: '/image-tools/resize-image/', icon: '🖼️', desc: 'Client-side photo and image dimension resizer' },
  { name: 'BMI Calculator', url: '/health/bmi-calculator/', icon: '🏃', desc: 'Calculate Body Mass Index and healthy weight' },
  { name: 'SIP Calculator', url: '/finance/sip-calculator/', icon: '📈', desc: 'Estimate mutual fund returns and wealth growth' },
];
---

<Layout
  title="500: Server Error - ToolsOfTools"
  description="An unexpected server error occurred. Please try reloading the page or explore our free client-side calculators and utilities."
  noindex={true}
>
  <main id="main-content" class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">
      
      <!-- Error Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50 px-4 py-1.5 text-xs font-bold text-rose-700 shadow-2xs dark:border-rose-900/50 dark:bg-rose-950/30 dark:text-rose-300">
        <span class="h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
        <span>ERROR 500</span>
      </div>

      <!-- Large Typography Heading -->
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl text-[#0D47A1] dark:text-white">
        Something Went Wrong
      </h1>
      
      <p class="mt-4 max-w-lg text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
        Our servers encountered an unexpected hiccup while processing this request. Our engineering team has been notified.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          onclick="window.location.reload()"
          class="inline-flex items-center gap-2 rounded-xl bg-[#0D47A1] px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#1565C0] active:scale-95 transition cursor-pointer"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span>Try Reloading</span>
        </button>

        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-xl border border-neutral-300 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 shadow-2xs hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition cursor-pointer"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>Return to Home</span>
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-xl border border-neutral-300 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 shadow-2xs hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition cursor-pointer"
        >
          <svg class="h-4 w-4 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Report Error</span>
        </a>
      </div>

      <!-- Troubleshooting Tips Card -->
      <div class="mt-10 w-full max-w-xl rounded-2xl border border-neutral-200 bg-neutral-50/70 p-5 text-left dark:border-neutral-800 dark:bg-neutral-850">
        <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Quick Troubleshooting Tips
        </h3>
        <ul class="mt-3 space-y-2 text-xs text-neutral-600 dark:text-neutral-300">
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">1.</span>
            <span><strong>Hard Refresh:</strong> Press <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 font-mono text-[11px]">Ctrl + F5</kbd> (or <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 font-mono text-[11px]">Cmd + Shift + R</kbd>) to bypass any stale cached JavaScript bundle.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">2.</span>
            <span><strong>Browser Extensions:</strong> Aggressive script-blocking extensions or corporate firewalls can occasionally disrupt static script loading. Try temporarily pausing them.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-500 font-bold">3.</span>
            <span><strong>Client-Side Resilience:</strong> Our tools run locally in browser memory. Once a tool page loads, it does not rely on a backend database.</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Popular Tools Shortcut Grid -->
    <div class="mt-16 border-t border-neutral-200 pt-12 dark:border-neutral-800">
      <h2 class="text-center text-lg font-bold text-neutral-900 dark:text-white">
        Explore Working Calculators While We Resolve This
      </h2>
      <p class="mt-1 text-center text-xs text-neutral-500 dark:text-neutral-400">
        All tools below are 100% operational and execute completely in your browser
      </p>

      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularTools.map((tool) => (
          <a
            href={tool.url}
            class="group flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-4 shadow-2xs hover:border-[#90CAF9] hover:bg-[#E3F2FD]/30 dark:border-neutral-800 dark:bg-neutral-850 dark:hover:border-neutral-700 transition"
          >
            <div>
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-100 text-base dark:bg-neutral-800">
                  {tool.icon}
                </span>
                <h3 class="text-sm font-bold text-neutral-900 group-hover:text-[#0D47A1] dark:text-white dark:group-hover:text-sky-300">
                  {tool.name}
                </h3>
              </div>
              <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2">
                {tool.desc}
              </p>
            </div>
            <div class="mt-3 flex items-center text-xs font-semibold text-[#0D47A1] dark:text-sky-300 group-hover:translate-x-1 transition-transform">
              <span>Open tool</span>
              <svg class="ml-1 h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Category Hubs List -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-2">
      <span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mr-1">Explore Hubs:</span>
      {hubs.map((hub) => (
        <a
          href={`/${hub.folder}/`}
          class="rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1 text-xs font-medium text-neutral-700 hover:bg-[#E3F2FD] hover:border-[#90CAF9] hover:text-[#0D47A1] dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 dark:hover:text-white transition"
        >
          {hub.name.replace(/\b\w/g, l => l.toUpperCase())}
        </a>
      ))}
    </div>

  </main>
</Layout>
