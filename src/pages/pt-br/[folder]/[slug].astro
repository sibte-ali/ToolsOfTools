---
import ToolPage from '../../../components/ToolPage.astro';
import { toolsByLang, type Tool } from '../../../lib/tools';

export function getStaticPaths() {
  const ptTools = toolsByLang('pt-br');
  return ptTools.map((tool) => ({
    params: { folder: tool.folder, slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<ToolPage lang="pt-br" tool={tool} />
