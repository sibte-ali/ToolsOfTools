---
import ToolPage from '../../../components/ToolPage.astro';
import { toolsByLang, type Tool } from '../../../lib/tools';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const ptTools = toolsByLang('pt-br');
  const ptSlugs = new Set(ptTools.map((t) => t.slug));
  // Exclude Hindi/Indian font converters from Portuguese translations
  const enTools = toolsByLang('en').filter((t) => !ptSlugs.has(t.slug) && t.folder !== 'font-converters');

  const paths = await Promise.all(
    ptTools.map(async (tool) => {
      const entry = await getEntry('tools', `pt-br/${tool.slug}`);
      return {
        params: { folder: tool.folder, slug: tool.slug },
        props: { tool, entry },
      };
    })
  );

  for (const tool of enTools) {
    const localizedTool: Tool = {
      ...tool,
      lang: 'pt-br',
      url: `/pt-br${tool.url}`,
    };
    paths.push({
      params: { folder: tool.folder, slug: tool.slug },
      props: { tool: localizedTool, entry: undefined },
    });
  }

  return paths;
}

interface Props {
  tool: Tool;
  entry?: any;
}

const { tool, entry } = Astro.props;
---

<ToolPage lang="pt-br" tool={tool} entry={entry} />
