---
import type { ToolConfig, OutputFormat } from '../../lib/engine/types';
import { renderSvgChart } from '../../lib/engine/chart';
import { getTranslations, type SupportedLanguage } from '../../i18n';

interface Props {
  config: ToolConfig;
  lang?: SupportedLanguage;
}

const { config, lang = 'en' } = Astro.props;
const t = getTranslations(lang);

// Which inputs use full-width layout (textarea needs col-span-full)
const hasTextarea = config.inputs.some((i) => i.type === 'textarea');

// Build-time default values
const defaultValues: Record<string, any> = {};
for (const input of config.inputs) {
  defaultValues[input.key] = input.default;
}

// Compute initial result at build time
const initialResult = config.compute(defaultValues);
const initialOutputs: Record<string, any> =
  initialResult instanceof Error ? {} : initialResult;

// Initial table data
const initialTableData = config.table ? config.table(defaultValues) : null;
const tableRows = Array.isArray(initialTableData)
  ? initialTableData
  : initialTableData?.rows || [];
const tableColumns =
  initialTableData && !Array.isArray(initialTableData) && initialTableData.columns
    ? initialTableData.columns
    : tableRows.length > 0
    ? Object.keys(tableRows[0]).map((k) => ({ key: k, label: k }))
    : [];

// Initial chart
const initialChartSvg =
  config.chart && config.chart !== 'none' && initialOutputs.chartData
    ? renderSvgChart(initialOutputs.chartData)
    : '';

function formatOutput(
  val: any,
  format: OutputFormat,
  locale: string,
  currency = 'USD'
): string {
  if (val === undefined || val === null) return '';
  if (typeof val === 'string') return val;

  const num = Number(val);
  if (isNaN(num)) return String(val);

  switch (format) {
    case 'currency':
      try {
        return new Intl.NumberFormat(locale, {
          style: 'currency',
          currency,
          maximumFractionDigits: 2,
        }).format(num);
      } catch {
        return `${currency} ${num.toLocaleString(locale, { maximumFractionDigits: 2 })}`;
      }
    case 'percent':
      return `${num.toLocaleString(locale, { maximumFractionDigits: 2 })}%`;
    case 'number':
      return num.toLocaleString(locale, { maximumFractionDigits: 2 });
    case 'duration':
      return `${num} days`;
    case 'date':
      return new Date(val).toLocaleDateString(locale);
    case 'text':
    default:
      return String(val);
  }
}

function isCodeOutput(format: OutputFormat): boolean {
  return format === 'code';
}
---

<div
  class="calculator-engine-container min-h-[340px] rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900 transition-all"
  data-calculator-tool="true"
  data-tool-id={config.id}
  data-tool-lang={config.lang}
  data-number-locale={config.numberLocale}
  data-currency={config.currency || 'USD'}
>
  <form class="calculator-form space-y-6" onsubmit="return false;">
    <div class={hasTextarea ? 'flex flex-col gap-5' : 'grid grid-cols-1 gap-5 sm:grid-cols-2'}>
      {
        config.inputs.map((input) => {
          const inputId = `calc-input-${input.key}`;
          return (
            <div class="flex flex-col justify-between">
              <div>
                <label
                  for={inputId}
                  class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300"
                >
                  {input.label}
                  {input.unit && (
                    <span class="ml-1 text-neutral-400 dark:text-neutral-500 font-normal">
                      ({input.unit})
                    </span>
                  )}
                </label>

                {input.type === 'number' && (
                  <div class="relative mt-1.5">
                    <input
                      type="number"
                      id={inputId}
                      name={input.key}
                      value={input.default}
                      min={input.min}
                      max={input.max}
                      step={input.step || 'any'}
                      required
                      class="block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white font-mono"
                    />
                  </div>
                )}

                {input.type === 'select' && (
                  <select
                    id={inputId}
                    name={input.key}
                    class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white"
                  >
                    {input.options?.map((opt) => (
                      <option value={opt.value} selected={opt.value === input.default}>
                        {opt.label}
                      </option>
                    ))}
                  </select>
                )}

                {input.type === 'date' && (
                  <input
                    type="date"
                    id={inputId}
                    name={input.key}
                    value={input.default}
                    required
                    class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white font-mono"
                  />
                )}

                {input.type === 'time' && (
                  <input
                    type="time"
                    id={inputId}
                    name={input.key}
                    value={input.default}
                    required
                    class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white font-mono"
                  />
                )}

                {input.type === 'text' && (
                  <input
                    type="text"
                    id={inputId}
                    name={input.key}
                    value={input.default}
                    class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white"
                  />
                )}

                {input.type === 'textarea' && (
                  <textarea
                    id={inputId}
                    name={input.key}
                    rows={8}
                    class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3.5 py-2.5 text-sm text-neutral-900 shadow-xs focus:border-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white dark:focus:ring-white font-mono resize-y leading-relaxed"
                  >{input.default}</textarea>
                )}

                {input.type === 'rows' && (
                  <div class="mt-2 space-y-2">
                    <div data-rows-for={input.key} class="space-y-2">
                      {Array.isArray(input.default) &&
                        input.default.map((row: any) => (
                          <div class="calculator-row-item flex items-center gap-3 p-2 bg-neutral-50 dark:bg-neutral-800/50 rounded-lg border border-neutral-200 dark:border-neutral-700">
                            {input.rowFields?.map((rf) => (
                              <div class="flex-1">
                                <input
                                  type={rf.type}
                                  data-row-field={rf.key}
                                  value={row[rf.key] ?? rf.default ?? ''}
                                  class="w-full text-xs font-mono rounded border border-neutral-300 dark:border-neutral-700 px-2 py-1 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white"
                                  placeholder={rf.label}
                                />
                              </div>
                            ))}
                            <button
                              type="button"
                              data-remove-row="true"
                              class="text-xs text-red-500 hover:text-red-700 p-1 cursor-pointer"
                            >
                              &times;
                            </button>
                          </div>
                        ))}
                    </div>
                    <button
                      type="button"
                      data-add-row={input.key}
                      class="mt-2 inline-flex items-center text-xs font-semibold text-neutral-700 hover:text-neutral-950 dark:text-neutral-300 dark:hover:text-white cursor-pointer"
                    >
                      + Add Item
                    </button>
                  </div>
                )}

                {input.help && (
                  <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400">
                    {input.help}
                  </p>
                )}
              </div>

              <div
                data-error-for={input.key}
                class="mt-1.5 text-xs text-red-600 dark:text-red-400 hidden font-medium"
              />
            </div>
          );
        })
      }
    </div>

    {config.id === 'tone-generator' && (
      <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/50 dark:bg-amber-950/30">
        <div class="flex items-start gap-2.5 text-xs text-amber-900 dark:text-amber-200 mb-3">
          <span class="text-base leading-none">⚠️</span>
          <p>
            <strong>Hearing Safety Notice:</strong> Pure test tones at high volume can cause auditory damage or fatigue. Always begin at low volume and avoid high continuous levels with headphones.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            id="tone-play-btn"
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 active:scale-95 transition cursor-pointer"
          >
            <span>▶ Play Tone</span>
          </button>

          <button
            type="button"
            id="tone-sweep-btn"
            class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-300 bg-white px-3.5 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 transition cursor-pointer"
          >
            <span>Frequency Sweep (100–1000 Hz)</span>
          </button>

          <div class="flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 ml-auto">
            <span class="font-semibold">Quick Tuning Presets:</span>
            <button type="button" class="preset-pill px-2.5 py-1 rounded bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs cursor-pointer" data-freq="440">A440</button>
            <button type="button" class="preset-pill px-2.5 py-1 rounded bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs cursor-pointer" data-freq="261.63">C4 (261.6 Hz)</button>
            <button type="button" class="preset-pill px-2.5 py-1 rounded bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs cursor-pointer" data-freq="1000">1 kHz</button>
            <button type="button" class="preset-pill px-2.5 py-1 rounded bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-xs cursor-pointer" data-freq="432">432 Hz</button>
          </div>
        </div>

        <script is:inline>
          (function() {
            let audioCtx = null;
            let osc = null;
            let gainNode = null;
            let isPlaying = false;

            const playBtn = document.getElementById('tone-play-btn');
            const sweepBtn = document.getElementById('tone-sweep-btn');

            function getInputs() {
              const freqInput = document.querySelector('input[name="frequency"]');
              const waveInput = document.querySelector('select[name="waveform"]');
              const volInput = document.querySelector('input[name="volume"]');
              const freq = freqInput ? parseFloat(freqInput.value) || 440 : 440;
              const wave = waveInput ? waveInput.value : 'sine';
              const volPct = volInput ? Math.min(50, Math.max(0, parseFloat(volInput.value) || 15)) : 15;
              return { freq, wave, gain: (volPct / 100) * 0.5 };
            }

            function startTone(targetFreq, targetWave, targetGain) {
              if (!audioCtx) {
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtxClass) {
                  alert('Web Audio API is not supported in this browser.');
                  return;
                }
                audioCtx = new AudioCtxClass();
              }

              if (audioCtx.state === 'suspended') {
                audioCtx.resume();
              }

              if (osc) {
                try { osc.stop(); osc.disconnect(); } catch (e) {}
              }

              const { freq, wave, gain } = getInputs();
              const f = targetFreq !== undefined ? targetFreq : freq;
              const w = targetWave !== undefined ? targetWave : wave;
              const g = targetGain !== undefined ? targetGain : gain;

              gainNode = audioCtx.createGain();
              gainNode.gain.setValueAtTime(g, audioCtx.currentTime);
              gainNode.connect(audioCtx.destination);

              osc = audioCtx.createOscillator();
              osc.type = w;
              osc.frequency.setValueAtTime(f, audioCtx.currentTime);
              osc.connect(gainNode);
              osc.start();

              isPlaying = true;
              if (playBtn) {
                playBtn.innerHTML = '<span>⏹ Stop Tone</span>';
                playBtn.className = playBtn.className.replace('bg-emerald-600 hover:bg-emerald-700', 'bg-red-600 hover:bg-red-700');
              }
            }

            function stopTone() {
              if (osc) {
                try { osc.stop(); osc.disconnect(); } catch (e) {}
                osc = null;
              }
              isPlaying = false;
              if (playBtn) {
                playBtn.innerHTML = '<span>▶ Play Tone</span>';
                playBtn.className = playBtn.className.replace('bg-red-600 hover:bg-red-700', 'bg-emerald-600 hover:bg-emerald-700');
              }
            }

            if (playBtn) {
              playBtn.addEventListener('click', function() {
                if (isPlaying) {
                  stopTone();
                } else {
                  startTone();
                }
              });
            }

            if (sweepBtn) {
              sweepBtn.addEventListener('click', function() {
                startTone(100, 'sine', 0.1);
                if (osc && audioCtx) {
                  osc.frequency.exponentialRampToValueAtTime(1000, audioCtx.currentTime + 3);
                  setTimeout(function() {
                    if (isPlaying) stopTone();
                  }, 3200);
                }
              });
            }

            // Real-time parameter updates while playing
            document.addEventListener('input', function(e) {
              if (!isPlaying || !osc || !gainNode || !audioCtx) return;
              const name = e.target && e.target.name;
              const { freq, wave, gain } = getInputs();
              if (name === 'frequency') {
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
              } else if (name === 'waveform') {
                osc.type = wave;
              } else if (name === 'volume') {
                gainNode.gain.setValueAtTime(gain, audioCtx.currentTime);
              }
            });

            // Preset buttons
            document.querySelectorAll('.preset-pill').forEach(function(pill) {
              pill.addEventListener('click', function() {
                const targetF = parseFloat(pill.getAttribute('data-freq'));
                const freqInput = document.querySelector('input[name="frequency"]');
                if (freqInput) {
                  freqInput.value = targetF;
                  freqInput.dispatchEvent(new Event('input', { bubbles: true }));
                }
                if (isPlaying && osc && audioCtx) {
                  osc.frequency.setValueAtTime(targetF, audioCtx.currentTime);
                }
              });
            });
          })();
        </script>
      </div>
    )}

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-800">
      <div class="flex items-center gap-3">
        <button
          type="submit"
          class="rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-offset-2 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100 transition cursor-pointer"
        >
          {t.calculate}
        </button>
        <button
          type="button"
          data-action="reset"
          class="rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700 hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 transition cursor-pointer"
        >
          {t.reset}
        </button>
      </div>

      <button
        type="button"
        data-action="copy-result"
        class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-neutral-50 px-3.5 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-750 transition cursor-pointer"
      >
        <span>{t.copy}</span>
      </button>
    </div>

    <div
      data-global-error
      class="rounded-lg bg-red-50 p-3 text-xs text-red-700 dark:bg-red-950/40 dark:text-red-300 hidden"
    />
  </form>

  <!-- Server-rendered default result container with aria-live="polite" -->
  <div
    role="region"
    aria-live="polite"
    aria-label="Calculation results"
    class="mt-8 rounded-xl border border-neutral-200 bg-neutral-50/80 p-6 dark:border-neutral-800 dark:bg-neutral-800/40 min-h-[100px]"
  >
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        config.outputs.map((out) => {
          const rawVal = initialOutputs[out.key];
          const formattedVal = formatOutput(
            rawVal,
            out.format,
            config.numberLocale,
            config.currency
          );
          return (
            <div
              class={
                out.highlight
                  ? 'sm:col-span-2 lg:col-span-1 rounded-xl bg-white p-4 shadow-xs border border-neutral-200 dark:bg-neutral-900 dark:border-neutral-700'
                  : 'p-1'
              }
            >
              <div class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
                {out.label}
              </div>
              <div
                data-output-key={out.key}
                class={
                  out.highlight
                    ? 'mt-1 text-3xl font-extrabold tracking-tight text-neutral-950 dark:text-white font-mono'
                    : 'mt-1 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono'
                }
              >
                {formattedVal}
              </div>
            </div>
          );
        })
      }
    </div>

    {/* Code output block - full width below the grid */}
    {
      config.outputs.some((o) => o.format === 'code') && (
        <div class="mt-6 space-y-4">
          {config.outputs
            .filter((o) => o.format === 'code')
            .map((out) => {
              const rawVal = initialOutputs[out.key];
              const strVal = rawVal != null ? String(rawVal) : '';
              return (
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2">
                    {out.label}
                  </div>
                  <pre
                    data-output-key={out.key}
                    class="block w-full overflow-x-auto rounded-lg border border-neutral-300 bg-neutral-50 p-4 text-sm text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800/70 dark:text-neutral-100 font-mono whitespace-pre leading-relaxed min-h-[160px]"
                  >{strVal}</pre>
                  <div class="mt-2 flex gap-2">
                    <button
                      type="button"
                      data-copy-key={out.key}
                      class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 transition cursor-pointer"
                    >
                      📋 Copy
                    </button>
                    <button
                      type="button"
                      data-download-key={out.key}
                      data-filename={`${config.id}-output.json`}
                      class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 transition cursor-pointer"
                    >
                      ⬇ Download
                    </button>
                  </div>
                </div>
              );
            })}
        </div>
      )
    }
  </div>

  <!-- Chart Region -->
  {
    config.chart && config.chart !== 'none' && (
      <div data-chart-container class="mt-8 overflow-hidden rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
        <Fragment set:html={initialChartSvg} />
      </div>
    )
  }

  <!-- Table Region (Amortization / Schedule) -->
  {
    config.table && tableRows.length > 0 && (
      <div data-table-container class="mt-8">
        <div class="overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-800">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
              <tr>
                {tableColumns.map((col: any) => (
                  <th class="px-4 py-2.5 font-semibold capitalize">{col.label}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800 bg-white dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200">
              {tableRows.map((row: any) => (
                <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition">
                  {tableColumns.map((col: any) => (
                    <td class="px-4 py-2">
                      {formatOutput(
                        row[col.key],
                        col.format || 'number',
                        config.numberLocale,
                        config.currency
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</div>

<script src="../../lib/engine/client.ts"></script>
