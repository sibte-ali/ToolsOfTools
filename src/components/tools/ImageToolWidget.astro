---
import type { Tool } from '../../lib/tools';
import type { SupportedLanguage } from '../../i18n';
import { PASSPORT_PRESETS } from '../../lib/image/image-engine';

interface Props {
  tool: Tool;
  lang: SupportedLanguage;
}

const { tool, lang } = Astro.props;
const slug = tool.slug;

const isConversionTool = slug === 'webp-to-jpg' || slug === 'image-to-jpg' || slug === 'avif-to-jpg';
const isCompressTool = slug === 'compress-image' || slug === 'reduce-image-size';
const isResizeTool = slug === 'resize-image' || slug === 'resize-pixel' || slug === 'web-resizer';
const isCropTool = slug === 'crop-image';
const isPassportTool = slug === 'passport-size-photo-maker';
const isDpiTool = slug === 'dpi-converter';
const imageTextByLang: Record<string, { uploadTitle: string; uploadDesc: string; selectBtn: string }> = {
  it: {
    uploadTitle: "Fai clic per scegliere un'immagine o trascinala qui",
    uploadDesc: 'Supporta PNG, JPG, WebP, AVIF, BMP, GIF. Elaborazione 100% privata nel tuo browser con zero caricamenti su server.',
    selectBtn: 'Seleziona Immagine',
  },
  fr: {
    uploadTitle: 'Cliquez pour choisir une image ou glissez-déposez ici',
    uploadDesc: 'Prend en charge PNG, JPG, WebP, AVIF, BMP, GIF. Traité à 100% de manière privée dans votre navigateur.',
    selectBtn: 'Sélectionner une Image',
  },
  de: {
    uploadTitle: 'Klicken Sie zum Auswählen oder ziehen Sie das Bild hierher',
    uploadDesc: 'Unterstützt PNG, JPG, WebP, AVIF, BMP, GIF. 100 % privat in Ihrem Browser ohne Server-Upload verarbeitet.',
    selectBtn: 'Bild Auswählen',
  },
  es: {
    uploadTitle: 'Haz clic para seleccionar una imagen o arrástrala aquí',
    uploadDesc: 'Soporta PNG, JPG, WebP, AVIF, BMP, GIF. Procesado 100% de forma privada en tu navegador sin subidas a servidores.',
    selectBtn: 'Seleccionar Imagen',
  },
  'pt-br': {
    uploadTitle: 'Clique para escolher a imagem ou arraste para cá',
    uploadDesc: 'Suporta PNG, JPG, WebP, AVIF, BMP, GIF. Processado 100% privado no seu navegador sem envio para servidores.',
    selectBtn: 'Selecionar Imagem',
  },
};

const imgText = imageTextByLang[lang] || {
  uploadTitle: 'Click to choose image or drag & drop here',
  uploadDesc: 'Supports PNG, JPG, WebP, AVIF, BMP, GIF. Processed 100% privately in your browser with zero server uploads.',
  selectBtn: 'Select Image',
};
---

<div
  id="image-tool-container"
  class="min-h-[380px] rounded-2xl border border-neutral-200 bg-white p-6 shadow-xs dark:border-neutral-800 dark:bg-neutral-900 transition-all"
  data-slug={slug}
  data-lang={lang}
>
  <!-- 1. Drag & Drop Upload Zone (Visible initially) -->
  <div id="image-dropzone" class="relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 bg-neutral-50/70 p-10 text-center hover:border-neutral-500 hover:bg-neutral-100/50 dark:border-neutral-700 dark:bg-neutral-800/40 dark:hover:border-neutral-500 dark:hover:bg-neutral-800/80 transition-all cursor-pointer">
    <input
      type="file"
      id="image-file-input"
      class="absolute inset-0 h-full w-full opacity-0 cursor-pointer"
      accept="image/png, image/jpeg, image/webp, image/avif, image/bmp, image/gif, .jpg, .jpeg, .png, .webp, .avif, .bmp, .gif"
      aria-label="Upload Image File"
    />
    
    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-neutral-200 text-neutral-800 dark:bg-neutral-750 dark:text-neutral-200 mb-4 shadow-2xs">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>

    <h3 class="text-base font-bold text-neutral-900 dark:text-white">
      {imgText.uploadTitle}
    </h3>
    <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400 max-w-sm">
      {imgText.uploadDesc}
    </p>

    <div class="mt-4 inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-4 py-2 text-xs font-semibold text-white dark:bg-white dark:text-neutral-900 shadow-xs pointer-events-none">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
      </svg>
      <span>{imgText.selectBtn}</span>
    </div>
  </div>

  <!-- 2. Processing Workspace (Visible after image upload) -->
  <div id="image-workspace" class="hidden space-y-6">
    <!-- Top Info Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-neutral-200 pb-4 dark:border-neutral-800">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <div id="orig-filename" class="text-sm font-bold text-neutral-900 dark:text-white truncate max-w-xs sm:max-w-md">
            image.jpg
          </div>
          <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 font-mono">
            <span id="orig-dims">0 × 0 px</span>
            <span>•</span>
            <span id="orig-size">0 KB</span>
          </div>
        </div>
      </div>

      <button
        type="button"
        id="btn-upload-another"
        class="inline-flex items-center gap-1.5 rounded-lg border border-neutral-300 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-750 transition cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Change Image</span>
      </button>
    </div>

    <!-- Controls Region (Adapts based on tool) -->
    <div class="rounded-xl border border-neutral-200 bg-neutral-50/50 p-5 dark:border-neutral-800 dark:bg-neutral-850/40 space-y-4">
      
      <!-- Conversion Controls -->
      {
        (isConversionTool || slug === 'web-resizer') && (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="ctrl-quality" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                JPEG Quality: <span id="val-quality" class="font-mono text-neutral-900 dark:text-white font-bold">90%</span>
              </label>
              <input
                type="range"
                id="ctrl-quality"
                min="10"
                max="100"
                value="90"
                step="5"
                class="mt-2 w-full accent-neutral-900 dark:accent-white cursor-pointer"
              />
            </div>
            <div>
              <label for="ctrl-bg-color" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Background Color for Transparency:
              </label>
              <div class="mt-2 flex items-center gap-3">
                <input
                  type="color"
                  id="ctrl-bg-color"
                  value="#ffffff"
                  class="h-9 w-14 rounded border border-neutral-300 dark:border-neutral-700 bg-white p-1 cursor-pointer"
                />
                <span class="text-xs text-neutral-500 dark:text-neutral-400">White default (prevents black background in JPG)</span>
              </div>
            </div>
          </div>
        )
      }

      <!-- Compression / Reduce Size Controls -->
      {
        isCompressTool && (
          <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="ctrl-quality" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Compression Level / Quality: <span id="val-quality" class="font-mono text-neutral-900 dark:text-white font-bold">80%</span>
                </label>
                <input
                  type="range"
                  id="ctrl-quality"
                  min="10"
                  max="100"
                  value="80"
                  step="5"
                  class="mt-2 w-full accent-neutral-900 dark:accent-white cursor-pointer"
                />
              </div>

              <div>
                <label for="ctrl-max-width" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Max Dimension (Optional Limit):
                </label>
                <select
                  id="ctrl-max-width"
                  class="mt-2 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white"
                >
                  <option value="0">Original Resolution (No downscale)</option>
                  <option value="1920">Max 1920 px (Full HD)</option>
                  <option value="1280">Max 1280 px (HD)</option>
                  <option value="800">Max 800 px (Web/Email)</option>
                </select>
              </div>
            </div>

            <!-- Target KB presets (especially for reduce-image-size) -->
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-2">
                Quick Target Size Presets:
              </span>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="20">Target 20 KB</button>
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="50">Target 50 KB</button>
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="100">Target 100 KB</button>
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="200">Target 200 KB</button>
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="500">Target 500 KB</button>
                <button type="button" class="preset-kb-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer transition" data-kb="1000">Target 1 MB</button>
              </div>
            </div>
          </div>
        )
      }

      <!-- Resize Controls -->
      {
        isResizeTool && (
          <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              <div>
                <label for="ctrl-resize-w" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Width (px)
                </label>
                <input
                  type="number"
                  id="ctrl-resize-w"
                  min="10"
                  max="10000"
                  step="1"
                  class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 font-mono text-sm text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white"
                />
              </div>

              <div>
                <label for="ctrl-resize-h" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Height (px)
                </label>
                <input
                  type="number"
                  id="ctrl-resize-h"
                  min="10"
                  max="10000"
                  step="1"
                  class="mt-1.5 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 font-mono text-sm text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white"
                />
              </div>

              <div class="flex items-end pb-2">
                <label class="flex items-center gap-2 text-xs font-medium text-neutral-800 dark:text-neutral-200 cursor-pointer">
                  <input
                    type="checkbox"
                    id="ctrl-aspect-lock"
                    checked
                    class="h-4 w-4 rounded border-neutral-300 text-neutral-900 dark:border-neutral-700 accent-neutral-900 dark:accent-white"
                  />
                  <span>Lock Aspect Ratio</span>
                </label>
              </div>
            </div>

            <!-- Resize scale slider -->
            <div>
              <label for="ctrl-resize-scale" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Scale Percentage: <span id="val-scale" class="font-mono text-neutral-900 dark:text-white font-bold">100%</span>
              </label>
              <input
                type="range"
                id="ctrl-resize-scale"
                min="10"
                max="200"
                value="100"
                step="5"
                class="mt-2 w-full accent-neutral-900 dark:accent-white cursor-pointer"
              />
            </div>

            <!-- Quick resolution presets -->
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-2">
                Resolution Presets:
              </span>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="preset-res-btn rounded-lg border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer" data-w="1920" data-h="1080">1920 × 1080 (1080p)</button>
                <button type="button" class="preset-res-btn rounded-lg border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer" data-w="1280" data-h="720">1280 × 720 (720p)</button>
                <button type="button" class="preset-res-btn rounded-lg border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer" data-w="1080" data-h="1080">1080 × 1080 (Square)</button>
                <button type="button" class="preset-res-btn rounded-lg border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer" data-w="768" data-h="0">768 px (Tablet)</button>
                <button type="button" class="preset-res-btn rounded-lg border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700 cursor-pointer" data-w="480" data-h="0">480 px (Mobile)</button>
              </div>
            </div>
          </div>
        )
      }

      <!-- Crop Image Controls -->
      {
        isCropTool && (
          <div class="space-y-4">
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-2">
                Crop Aspect Ratio:
              </span>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="crop-ratio-btn rounded-lg border-2 border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-neutral-900 px-3 py-1.5 text-xs font-bold cursor-pointer" data-ratio="1:1">1:1 Square</button>
                <button type="button" class="crop-ratio-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer" data-ratio="4:3">4:3 Standard</button>
                <button type="button" class="crop-ratio-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer" data-ratio="16:9">16:9 Widescreen</button>
                <button type="button" class="crop-ratio-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer" data-ratio="3:2">3:2 Photo</button>
                <button type="button" class="crop-ratio-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer" data-ratio="35:45">35:45 (Passport)</button>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="ctrl-crop-zoom" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Zoom / Framing: <span id="val-crop-zoom" class="font-mono text-neutral-900 dark:text-white font-bold">1.0×</span>
                </label>
                <input
                  type="range"
                  id="ctrl-crop-zoom"
                  min="0.5"
                  max="3.0"
                  step="0.05"
                  value="1.0"
                  class="mt-2 w-full accent-neutral-900 dark:accent-white cursor-pointer"
                />
              </div>
              <div class="flex items-center gap-2 pt-4">
                <button type="button" id="btn-rotate-90" class="rounded-lg border border-neutral-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer">
                  ↻ Rotate 90°
                </button>
                <button type="button" id="btn-flip-h" class="rounded-lg border border-neutral-300 bg-white px-3 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer">
                  ⇄ Flip Horizontal
                </button>
              </div>
            </div>
          </div>
        )
      }

      <!-- Passport Size Photo Maker Controls -->
      {
        isPassportTool && (
          <div class="space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="ctrl-passport-preset" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                  Passport Standard & Dimensions:
                </label>
                <select
                  id="ctrl-passport-preset"
                  class="mt-2 block w-full rounded-lg border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-white font-medium"
                >
                  {
                    PASSPORT_PRESETS.map((preset) => (
                      <option value={preset.id} data-w={preset.widthPx} data-h={preset.heightPx} data-dpi={preset.dpi} data-label={preset.name}>
                        {preset.name}
                      </option>
                    ))
                  }
                </select>
                <p id="passport-preset-desc" class="mt-1.5 text-[11px] text-neutral-500 dark:text-neutral-400">
                  Standard 35x45mm at 300 DPI for Indian passports, Schengen visa, UK, and Australian travel.
                </p>
              </div>

              <div class="space-y-3">
                <div>
                  <label for="ctrl-passport-zoom" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                    Zoom Face to Guidelines: <span id="val-passport-zoom" class="font-mono text-neutral-900 dark:text-white font-bold">1.0×</span>
                  </label>
                  <input
                    type="range"
                    id="ctrl-passport-zoom"
                    min="0.5"
                    max="3.0"
                    step="0.05"
                    value="1.0"
                    class="mt-2 w-full accent-neutral-900 dark:accent-white cursor-pointer"
                  />
                </div>

                <div class="flex flex-wrap items-center gap-4">
                  <label class="flex items-center gap-2 text-xs font-medium text-neutral-800 dark:text-neutral-200 cursor-pointer">
                    <input
                      type="checkbox"
                      id="ctrl-passport-guides"
                      checked
                      class="h-4 w-4 rounded border-neutral-300 text-neutral-900 dark:border-neutral-700 accent-neutral-900 dark:accent-white"
                    />
                    <span>Show Face & Chin Alignment Guides</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        )
      }

      <!-- DPI Converter Controls -->
      {
        isDpiTool && (
          <div class="space-y-4">
            <!-- 1. Quick Presets -->
            <div>
              <span class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 mb-2">
                Standard DPI Presets:
              </span>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="dpi-preset-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer transition" data-dpi="72">72 DPI (Web)</button>
                <button type="button" class="dpi-preset-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer transition" data-dpi="96">96 DPI (Screen)</button>
                <button type="button" class="dpi-preset-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer transition" data-dpi="150">150 DPI (Newsprint)</button>
                <button type="button" class="dpi-preset-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer transition" data-dpi="200">200 DPI (Scan / Document)</button>
                <button type="button" class="dpi-preset-btn rounded-lg border-2 border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-neutral-900 px-3 py-1.5 text-xs font-bold cursor-pointer transition" data-dpi="300">300 DPI (Standard Print / Passport)</button>
