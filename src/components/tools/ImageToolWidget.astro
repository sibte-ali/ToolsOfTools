<!-- Core Client-Side Image Processor Script -->
<script is:inline>
  // CRC-32 checksum utility for PNG chunks
  function crc32(buf) {
    let c = 0xffffffff;
    for (let i = 0; i < buf.length; i++) {
      c ^= buf[i];
      for (let k = 0; k < 8; k++) {
        c = (c >>> 1) ^ (0xedb88320 & -(c & 1));
      }
    }
    return (c ^ 0xffffffff) >>> 0;
  }

  // Embeds or updates JFIF APP0 DPI metadata in JPEG Uint8Array
  function setJpegDpi(buffer, dpi) {
    if (buffer.length < 4 || buffer[0] !== 0xff || buffer[1] !== 0xd8) {
      return buffer;
    }
    const dpiInt = Math.max(1, Math.min(65535, Math.round(dpi)));
    const dpiHigh = (dpiInt >> 8) & 0xff;
    const dpiLow = dpiInt & 0xff;

    // Existing APP0 JFIF marker?
    if (
      buffer[2] === 0xff &&
      buffer[3] === 0xe0 &&
      buffer[6] === 0x4a && // 'J'
      buffer[7] === 0x46 && // 'F'
      buffer[8] === 0x49 && // 'I'
      buffer[9] === 0x46 && // 'F'
      buffer[10] === 0x00
    ) {
      const copy = new Uint8Array(buffer);
      copy[13] = 1; // 1 = dots per inch (DPI)
      copy[14] = dpiHigh;
      copy[15] = dpiLow;
      copy[16] = dpiHigh;
      copy[17] = dpiLow;
      return copy;
    }

    // Inject standard 18-byte JFIF APP0 header
    const jfifHeader = new Uint8Array([
      0xff, 0xe0,
      0x00, 0x10,
      0x4a, 0x46, 0x49, 0x46, 0x00,
      0x01, 0x02,
      0x01, // Units: 1 = dots per inch
      dpiHigh, dpiLow,
      dpiHigh, dpiLow,
      0x00, 0x00,
    ]);

    const output = new Uint8Array(buffer.length + jfifHeader.length);
    output.set(buffer.subarray(0, 2), 0);
    output.set(jfifHeader, 2);
    output.set(buffer.subarray(2), 2 + jfifHeader.length);
    return output;
  }

  // Embeds or updates pHYs DPI metadata chunk in PNG Uint8Array
  function setPngDpi(buffer, dpi) {
    if (
      buffer.length < 33 ||
      buffer[0] !== 0x89 ||
      buffer[1] !== 0x50 ||
      buffer[2] !== 0x4e ||
      buffer[3] !== 0x47 ||
      buffer[4] !== 0x0d ||
      buffer[5] !== 0x0a ||
      buffer[6] !== 0x1a ||
      buffer[7] !== 0x0a
    ) {
      return buffer;
    }

    const ppm = Math.max(1, Math.min(0xffffffff, Math.round(dpi / 0.0254)));
    const ppmBytes = [
      (ppm >>> 24) & 0xff,
      (ppm >>> 16) & 0xff,
      (ppm >>> 8) & 0xff,
      ppm & 0xff,
    ];

    let pos = 33;
    while (pos + 8 <= buffer.length) {
      const chunkLen =
        (buffer[pos] << 24) |
        (buffer[pos + 1] << 16) |
        (buffer[pos + 2] << 8) |
        buffer[pos + 3];
      const chunkType = String.fromCharCode(
        buffer[pos + 4],
        buffer[pos + 5],
        buffer[pos + 6],
        buffer[pos + 7]
      );

      if (chunkType === 'pHYs' && chunkLen === 9) {
        const copy = new Uint8Array(buffer);
        copy.set(ppmBytes, pos + 8);
        copy.set(ppmBytes, pos + 12);
        copy[pos + 16] = 1;
        const crcVal = crc32(copy.subarray(pos + 4, pos + 17));
        copy[pos + 17] = (crcVal >>> 24) & 0xff;
        copy[pos + 18] = (crcVal >>> 16) & 0xff;
        copy[pos + 19] = (crcVal >>> 8) & 0xff;
        copy[pos + 20] = crcVal & 0xff;
        return copy;
      }

      if (chunkType === 'IDAT' || chunkType === 'IEND') break;
      pos += 12 + chunkLen;
    }

    const physChunk = new Uint8Array(21);
    physChunk[3] = 9;
    physChunk[4] = 0x70; // p
    physChunk[5] = 0x48; // H
    physChunk[6] = 0x59; // y
    physChunk[7] = 0x73; // s
    physChunk.set(ppmBytes, 8);
    physChunk.set(ppmBytes, 12);
    physChunk[16] = 1;
    const crc = crc32(physChunk.subarray(4, 17));
    physChunk[17] = (crc >>> 24) & 0xff;
    physChunk[18] = (crc >>> 16) & 0xff;
    physChunk[19] = (crc >>> 8) & 0xff;
    physChunk[20] = crc & 0xff;

    const output = new Uint8Array(buffer.length + 21);
    output.set(buffer.subarray(0, 33), 0);
    output.set(physChunk, 33);
    output.set(buffer.subarray(33), 33 + 21);
    return output;
  }

  // Cross-browser fail-safe programmatic download
  function triggerFileDownload(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.style.display = 'none';
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 2000);
  }

  function initImageTool() {
    const container = document.getElementById('image-tool-container');
    if (!container) return;

    const slug = container.getAttribute('data-slug') || '';
    const isConversionTool = slug === 'webp-to-jpg' || slug === 'image-to-jpg' || slug === 'avif-to-jpg';
    const isCompressTool = slug === 'compress-image' || slug === 'reduce-image-size';
    const isResizeTool = slug === 'resize-image' || slug === 'resize-pixel' || slug === 'web-resizer';
    const isCropTool = slug === 'crop-image';
    const isPassportTool = slug === 'passport-size-photo-maker';
    const isDpiTool = slug === 'dpi-converter';
    const fileInput = document.getElementById('image-file-input');
    const dropzone = document.getElementById('image-dropzone');
    const workspace = document.getElementById('image-workspace');
    const origFilename = document.getElementById('orig-filename');
    const origDims = document.getElementById('orig-dims');
    const origSize = document.getElementById('orig-size');
    const btnUploadAnother = document.getElementById('btn-upload-another');

    const previewCanvas = document.getElementById('preview-canvas');
    const statDims = document.getElementById('stat-output-dims');
    const statSize = document.getElementById('stat-output-size');
    const statFormat = document.getElementById('stat-output-format');
    const statDpi = document.getElementById('stat-output-dpi');
    const btnDownload = document.getElementById('btn-download-primary');
    const btnDownloadLabel = document.getElementById('btn-download-label');
    const btnDownloadSheet = document.getElementById('btn-download-sheet');
    const savingsBox = document.getElementById('savings-badge-box');
    const savingsText = document.getElementById('savings-text');

    // Controls
    const ctrlQuality = document.getElementById('ctrl-quality');
    const valQuality = document.getElementById('val-quality');
    const ctrlBgColor = document.getElementById('ctrl-bg-color');
    const ctrlMaxWidth = document.getElementById('ctrl-max-width');
    const ctrlResizeW = document.getElementById('ctrl-resize-w');
    const ctrlResizeH = document.getElementById('ctrl-resize-h');
    const ctrlAspectLock = document.getElementById('ctrl-aspect-lock');
    const ctrlResizeScale = document.getElementById('ctrl-resize-scale');
    const valScale = document.getElementById('val-scale');
    const ctrlCropZoom = document.getElementById('ctrl-crop-zoom');
    const valCropZoom = document.getElementById('val-crop-zoom');
    const ctrlPassportPreset = document.getElementById('ctrl-passport-preset');
    const passportPresetDesc = document.getElementById('passport-preset-desc');
    const ctrlPassportZoom = document.getElementById('ctrl-passport-zoom');
    const valPassportZoom = document.getElementById('val-passport-zoom');
    const ctrlPassportGuides = document.getElementById('ctrl-passport-guides');
    const passportGuidesOverlay = document.getElementById('passport-guide-overlay');

    // DPI Controls
    const ctrlDpiCustom = document.getElementById('ctrl-dpi-custom');
    const ctrlDpiFormat = document.getElementById('ctrl-dpi-format');
    const ctrlDpiQuality = document.getElementById('ctrl-dpi-quality');
    const valDpiQuality = document.getElementById('val-dpi-quality');
    const dpiQualityWrapper = document.getElementById('dpi-quality-wrapper');
    const dpiCalcInches = document.getElementById('dpi-calc-inches');
    const dpiCalcCm = document.getElementById('dpi-calc-cm');
    const dpiCalcMm = document.getElementById('dpi-calc-mm');
    const dpiFormulaPx = document.getElementById('dpi-formula-px');
    const dpiFormulaVal = document.getElementById('dpi-formula-val');
    const dpiFormulaSummary = document.getElementById('dpi-formula-summary');
    const dpiPresetBtns = document.querySelectorAll('.dpi-preset-btn');

    let loadedImage = null;
    let originalFile = null;
    let currentRotation = 0;
    let isFlippedH = false;
    let currentCropRatio = '1:1';
    let targetDpi = 300;
    let targetFormat = 'image/jpeg';
    let currentBlobUrl = null;
    let sheetBlobUrl = null;
    let currentDownloadBlob = null;
    let currentDownloadFilename = 'processed-image.jpg';
    let shouldDownloadOnReady = false;

    function formatBytes(bytes) {
      if (bytes <= 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    }

    function handleFile(file) {
      if (!file) return;
      if (!file.type.startsWith('image/') && !file.name.match(/\.(jpe?g|png|webp|avif|bmp|gif)$/i)) {
        return;
      }
      originalFile = file;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          loadedImage = img;
          currentRotation = 0;
          isFlippedH = false;

          // Populate original metadata
          origFilename.textContent = file.name;
          origDims.textContent = `${img.naturalWidth} × ${img.naturalHeight} px`;
          origSize.textContent = formatBytes(file.size);

          if (ctrlResizeW && ctrlResizeH) {
            ctrlResizeW.value = img.naturalWidth;
            ctrlResizeH.value = img.naturalHeight;
          }

          dropzone.classList.add('hidden');
          workspace.classList.remove('hidden');

          processAndRender();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    fileInput.addEventListener('change', function(e) {
      if (e.target.files && e.target.files[0]) {
        handleFile(e.target.files[0]);
      }
    });

    btnUploadAnother.addEventListener('click', function() {
      dropzone.classList.remove('hidden');
      workspace.classList.add('hidden');
      fileInput.value = '';
      currentDownloadBlob = null;
    });

    // Drag and drop events
    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, function(e) {
        e.preventDefault();
        dropzone.classList.add('border-neutral-900', 'dark:border-white');
      });
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, function(e) {
        e.preventDefault();
        dropzone.classList.remove('border-neutral-900', 'dark:border-white');
      });
    });

    dropzone.addEventListener('drop', function(e) {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    // Controls listeners
    if (ctrlQuality) {
      ctrlQuality.addEventListener('input', function(e) {
        if (valQuality) valQuality.textContent = e.target.value + '%';
        processAndRender();
      });
    }

    if (ctrlBgColor) {
      ctrlBgColor.addEventListener('input', processAndRender);
    }

    if (ctrlMaxWidth) {
      ctrlMaxWidth.addEventListener('change', processAndRender);
    }

    if (ctrlResizeScale) {
      ctrlResizeScale.addEventListener('input', function(e) {
        if (valScale) valScale.textContent = e.target.value + '%';
        if (loadedImage && ctrlResizeW && ctrlResizeH) {
          const pct = Number(e.target.value) / 100;
          ctrlResizeW.value = Math.round(loadedImage.naturalWidth * pct);
          ctrlResizeH.value = Math.round(loadedImage.naturalHeight * pct);
        }
        processAndRender();
      });
    }

    if (ctrlResizeW && ctrlResizeH) {
      ctrlResizeW.addEventListener('input', function() {
        if (ctrlAspectLock && ctrlAspectLock.checked && loadedImage) {
          const ratio = loadedImage.naturalHeight / loadedImage.naturalWidth;
          ctrlResizeH.value = Math.round(Number(ctrlResizeW.value) * ratio);
        }
        processAndRender();
      });

      ctrlResizeH.addEventListener('input', function() {
        if (ctrlAspectLock && ctrlAspectLock.checked && loadedImage) {
          const ratio = loadedImage.naturalWidth / loadedImage.naturalHeight;
          ctrlResizeW.value = Math.round(Number(ctrlResizeH.value) * ratio);
        }
        processAndRender();
      });
    }

    // Preset resolution buttons
    document.querySelectorAll('.preset-res-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const w = Number(btn.getAttribute('data-w'));
        const h = Number(btn.getAttribute('data-h'));
        if (ctrlResizeW) ctrlResizeW.value = w;
        if (ctrlResizeH) {
          if (h > 0) {
            ctrlResizeH.value = h;
          } else if (loadedImage) {
            const ratio = loadedImage.naturalHeight / loadedImage.naturalWidth;
            ctrlResizeH.value = Math.round(w * ratio);
          }
        }
        processAndRender();
      });
    });

    // Preset KB buttons
    document.querySelectorAll('.preset-kb-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const kb = Number(btn.getAttribute('data-kb'));
        if (ctrlQuality) {
          if (kb <= 50) ctrlQuality.value = 40;
          else if (kb <= 100) ctrlQuality.value = 60;
          else if (kb <= 200) ctrlQuality.value = 75;
          else ctrlQuality.value = 85;
          if (valQuality) valQuality.textContent = ctrlQuality.value + '%';
        }
        processAndRender();
      });
    });

    // Crop Aspect buttons
    document.querySelectorAll('.crop-ratio-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.crop-ratio-btn').forEach(b => {
          b.className = 'crop-ratio-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer';
        });
        btn.className = 'crop-ratio-btn rounded-lg border-2 border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-neutral-900 px-3 py-1.5 text-xs font-bold cursor-pointer';
        currentCropRatio = btn.getAttribute('data-ratio') || '1:1';
        processAndRender();
      });
    });

    if (ctrlCropZoom) {
      ctrlCropZoom.addEventListener('input', function(e) {
        if (valCropZoom) valCropZoom.textContent = Number(e.target.value).toFixed(1) + '×';
        processAndRender();
      });
    }

    const btnRotate = document.getElementById('btn-rotate-90');
    if (btnRotate) {
      btnRotate.addEventListener('click', function() {
        currentRotation = (currentRotation + 90) % 360;
        processAndRender();
      });
    }

    const btnFlip = document.getElementById('btn-flip-h');
    if (btnFlip) {
      btnFlip.addEventListener('click', function() {
        isFlippedH = !isFlippedH;
        processAndRender();
      });
    }

    // Passport controls
    if (ctrlPassportPreset) {
      ctrlPassportPreset.addEventListener('change', function() {
        const opt = ctrlPassportPreset.selectedOptions[0];
        if (passportPresetDesc) {
          const presetId = opt.value;
          if (presetId === 'us-visa') passportPresetDesc.textContent = 'Official 2x2 inch (51x51mm) square format for US Department of State visas and passports.';
          else if (presetId === 'canada') passportPresetDesc.textContent = 'Official Government of Canada passport standard (50x70mm at 300 DPI).';
          else if (presetId === 'pan-stamp') passportPresetDesc.textContent = 'Standard 25x35mm format for Indian PAN card, driving licence, and exam applications.';
          else passportPresetDesc.textContent = 'Standard 35x45mm at 300 DPI for Indian passports, Schengen visa, UK, and Australian travel.';
        }
        processAndRender();
      });
    }

    if (ctrlPassportZoom) {
      ctrlPassportZoom.addEventListener('input', function(e) {
        if (valPassportZoom) valPassportZoom.textContent = Number(e.target.value).toFixed(1) + '×';
        processAndRender();
      });
    }

    if (ctrlPassportGuides && passportGuidesOverlay) {
      ctrlPassportGuides.addEventListener('change', function() {
        passportGuidesOverlay.style.display = ctrlPassportGuides.checked ? 'flex' : 'none';
      });
    }

    // DPI Converter Preset Buttons & Custom Input wiring
    function syncDpiPresetButtons(activeDpi) {
      dpiPresetBtns.forEach(btn => {
        const btnDpi = Number(btn.getAttribute('data-dpi'));
        if (btnDpi === activeDpi) {
          btn.className = 'dpi-preset-btn rounded-lg border-2 border-neutral-900 bg-neutral-900 text-white dark:border-white dark:bg-white dark:text-neutral-900 px-3 py-1.5 text-xs font-bold cursor-pointer transition';
        } else {
          btn.className = 'dpi-preset-btn rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 cursor-pointer transition';
        }
      });
    }

    dpiPresetBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const dpiVal = Number(btn.getAttribute('data-dpi')) || 300;
        targetDpi = dpiVal;
        if (ctrlDpiCustom) ctrlDpiCustom.value = dpiVal;
        syncDpiPresetButtons(dpiVal);
        processAndRender();
      });
    });

    if (ctrlDpiCustom) {
      ['input', 'change'].forEach(evt => {
        ctrlDpiCustom.addEventListener(evt, function() {
          const val = parseInt(ctrlDpiCustom.value, 10);
          if (val && val > 0 && val <= 9600) {
            targetDpi = val;
            syncDpiPresetButtons(val);
            processAndRender();
          }
        });
      });
    }

    if (ctrlDpiFormat) {
      ctrlDpiFormat.addEventListener('change', function() {
        targetFormat = ctrlDpiFormat.value;
        if (dpiQualityWrapper) {
          dpiQualityWrapper.style.display = targetFormat === 'image/jpeg' ? 'block' : 'none';
        }
        processAndRender();
      });
    }

    if (ctrlDpiQuality) {
      ctrlDpiQuality.addEventListener('input', function(e) {
        if (valDpiQuality) valDpiQuality.textContent = e.target.value + '%';
        processAndRender();
      });
    }

    // Direct, reliable click handler on download button
    btnDownload.addEventListener('click', function(e) {
      e.preventDefault();
      if (currentDownloadBlob) {
        triggerFileDownload(currentDownloadBlob, currentDownloadFilename);
        const originalText = btnDownloadLabel.textContent;
        btnDownloadLabel.textContent = '✓ Downloaded!';
        setTimeout(() => {
          btnDownloadLabel.textContent = originalText;
        }, 1500);
      } else if (loadedImage) {
        shouldDownloadOnReady = true;
        btnDownloadLabel.textContent = 'Preparing download...';
        processAndRender();
      }
    });

    // Core Canvas & DPI Processing Routine
    function processAndRender() {
      if (!loadedImage) return;

      const imgW = loadedImage.naturalWidth;
      const imgH = loadedImage.naturalHeight;
      let outW = imgW;
      let outH = imgH;
      let quality = 0.92;
      let bgColor = ctrlBgColor ? ctrlBgColor.value : '#ffffff';

      if (slug === 'dpi-converter') {
        if (ctrlDpiFormat) targetFormat = ctrlDpiFormat.value;
        else targetFormat = 'image/jpeg';
        if (ctrlDpiQuality) quality = Number(ctrlDpiQuality.value) / 100;
        else quality = 0.95;
      } else {
        targetFormat = 'image/jpeg';
        if (ctrlQuality) quality = Number(ctrlQuality.value) / 100;
      }

      if (slug === 'passport-size-photo-maker') {
        const opt = ctrlPassportPreset.selectedOptions[0];
        outW = Number(opt.getAttribute('data-w')) || 413;
        outH = Number(opt.getAttribute('data-h')) || 531;
        targetDpi = Number(opt.getAttribute('data-dpi')) || 300;
        if (passportGuidesOverlay) {
          passportGuidesOverlay.style.display = ctrlPassportGuides && ctrlPassportGuides.checked ? 'flex' : 'none';
        }
      } else if (slug === 'crop-image') {
        let ratioW = 1, ratioH = 1;
        if (currentCropRatio === '4:3') { ratioW = 4; ratioH = 3; }
        else if (currentCropRatio === '16:9') { ratioW = 16; ratioH = 9; }
        else if (currentCropRatio === '3:2') { ratioW = 3; ratioH = 2; }
        else if (currentCropRatio === '35:45') { ratioW = 35; ratioH = 45; }

        outW = 800;
        outH = Math.round((outW * ratioH) / ratioW);
      } else if (isResizeTool) {
        outW = ctrlResizeW ? Number(ctrlResizeW.value) || imgW : imgW;
        outH = ctrlResizeH ? Number(ctrlResizeH.value) || imgH : imgH;
      } else if (isCompressTool) {
        if (ctrlMaxWidth && Number(ctrlMaxWidth.value) > 0) {
          const maxDim = Number(ctrlMaxWidth.value);
          if (imgW > maxDim || imgH > maxDim) {
            if (imgW >= imgH) {
              outW = maxDim;
              outH = Math.round((imgH * maxDim) / imgW);
            } else {
              outH = maxDim;
              outW = Math.round((imgW * maxDim) / imgH);
            }
          }
        }
      }

      previewCanvas.width = outW;
      previewCanvas.height = outH;
      const ctx = previewCanvas.getContext('2d');
      ctx.imageSmoothingQuality = 'high';

      // Fill background for transparency safety
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, outW, outH);

      // Transformations
      ctx.save();
      ctx.translate(outW / 2, outH / 2);
      if (currentRotation !== 0) {
        ctx.rotate((currentRotation * Math.PI) / 180);
      }
      if (isFlippedH) {
        ctx.scale(-1, 1);
      }

      let zoom = 1.0;
      if (slug === 'passport-size-photo-maker' && ctrlPassportZoom) {
        zoom = Number(ctrlPassportZoom.value);
      } else if (slug === 'crop-image' && ctrlCropZoom) {
        zoom = Number(ctrlCropZoom.value);
      }

      // Draw image centered and scaled
      const scale = Math.max(outW / imgW, outH / imgH) * zoom;
      const drawW = imgW * scale;
      const drawH = imgH * scale;

      ctx.drawImage(loadedImage, -drawW / 2, -drawH / 2, drawW, drawH);
      ctx.restore();

      // Convert to Blob with hardware DPI metadata injection
      previewCanvas.toBlob(async function(rawBlob) {
        if (!rawBlob) return;

        let finalBlob = rawBlob;
        try {
          const arrayBuf = await rawBlob.arrayBuffer();
          if (targetFormat === 'image/jpeg') {
            const withDpi = setJpegDpi(new Uint8Array(arrayBuf), targetDpi);
            finalBlob = new Blob([withDpi], { type: 'image/jpeg' });
          } else if (targetFormat === 'image/png') {
            const withDpi = setPngDpi(new Uint8Array(arrayBuf), targetDpi);
            finalBlob = new Blob([withDpi], { type: 'image/png' });
          }
        } catch (err) {
          console.warn('DPI metadata injection note:', err);
          finalBlob = rawBlob;
        }

        currentDownloadBlob = finalBlob;
        if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);
        currentBlobUrl = URL.createObjectURL(finalBlob);
        btnDownload.href = currentBlobUrl;

        // Dynamic filename
        const ext = targetFormat === 'image/png' ? 'png' : 'jpg';
        const baseName = originalFile ? originalFile.name.replace(/\.[^/.]+$/, '') : 'photo';

        if (slug === 'dpi-converter') {
          currentDownloadFilename = `${baseName}-${targetDpi}dpi.${ext}`;
          btnDownload.download = currentDownloadFilename;
          btnDownloadLabel.textContent = `Download Image (${targetDpi} DPI)`;
        } else if (slug === 'passport-size-photo-maker') {
          currentDownloadFilename = `${baseName}-passport-${outW}x${outH}.${ext}`;
          btnDownload.download = currentDownloadFilename;
          btnDownloadLabel.textContent = `Download Passport Photo (${outW}×${outH} px)`;
        } else if (slug === 'crop-image') {
          currentDownloadFilename = `${baseName}-cropped.${ext}`;
          btnDownload.download = currentDownloadFilename;
          btnDownloadLabel.textContent = `Download Cropped Image`;
        } else if (isCompressTool) {
          currentDownloadFilename = `${baseName}-compressed.${ext}`;
          btnDownload.download = currentDownloadFilename;
          btnDownloadLabel.textContent = `Download Compressed Image`;
        } else {
          currentDownloadFilename = `${baseName}-converted.${ext}`;
          btnDownload.download = currentDownloadFilename;
          btnDownloadLabel.textContent = `Download Converted Image`;
        }

        // Stats updates
        statDims.textContent = `${outW} × ${outH} px`;
        statSize.textContent = formatBytes(finalBlob.size);
        statFormat.textContent = targetFormat === 'image/png' ? 'PNG' : 'JPEG';
        statDpi.textContent = `${targetDpi} DPI`;

        // Savings indicator
        if (isCompressTool && originalFile) {
          savingsBox.classList.remove('hidden');
          if (finalBlob.size < originalFile.size) {
            const saved = originalFile.size - finalBlob.size;
            const pct = Math.round((saved / originalFile.size) * 100);
            savingsText.textContent = `Saved ${formatBytes(saved)} (${pct}% smaller)`;
          } else {
            savingsText.textContent = `Optimized at maximum quality`;
          }
        }

        // DPI print size & formula calculations
        if (dpiCalcInches && dpiCalcCm) {
          const inW = (outW / targetDpi).toFixed(2);
          const inH = (outH / targetDpi).toFixed(2);
          const cmW = ((outW / targetDpi) * 2.54).toFixed(2);
          const cmH = ((outH / targetDpi) * 2.54).toFixed(2);
          const mmW = Math.round((outW / targetDpi) * 25.4);
          const mmH = Math.round((outH / targetDpi) * 25.4);

          dpiCalcInches.textContent = `${inW} × ${inH}`;
          dpiCalcCm.textContent = `${cmW} × ${cmH}`;
          if (dpiCalcMm) dpiCalcMm.textContent = `${mmW} × ${mmH}`;

          if (dpiFormulaPx) dpiFormulaPx.textContent = `${outW} × ${outH} px`;
          if (dpiFormulaVal) dpiFormulaVal.textContent = `${targetDpi} DPI`;
          if (dpiFormulaSummary) dpiFormulaSummary.textContent = `${inW}" × ${inH}" (${cmW} × ${cmH} cm)`;
        }

        // Auto trigger download if user clicked while rendering
        if (shouldDownloadOnReady) {
          shouldDownloadOnReady = false;
          triggerFileDownload(finalBlob, currentDownloadFilename);
          btnDownloadLabel.textContent = '✓ Downloaded!';
          setTimeout(() => {
            btnDownloadLabel.textContent = `Download Image (${targetDpi} DPI)`;
          }, 1500);
        }

        // Generate 4x6 sheet if passport maker
        if (slug === 'passport-size-photo-maker' && btnDownloadSheet) {
          renderPrintableSheet(previewCanvas);
        }
      }, targetFormat, quality);
    }

    // Tiling for 4x6 inch printable photo sheet
    function renderPrintableSheet(singlePhotoCanvas) {
      const sheetCanvas = document.createElement('canvas');
      sheetCanvas.width = 1800;
      sheetCanvas.height = 1200;
      const sCtx = sheetCanvas.getContext('2d');
      sCtx.fillStyle = '#ffffff';
      sCtx.fillRect(0, 0, sheetCanvas.width, sheetCanvas.height);

      const photoW = singlePhotoCanvas.width;
      const photoH = singlePhotoCanvas.height;

      const cols = Math.floor((sheetCanvas.width - 100) / (photoW + 30)) || 3;
      const rows = Math.floor((sheetCanvas.height - 100) / (photoH + 30)) || 2;

      const marginX = Math.round((sheetCanvas.width - cols * (photoW + 30) + 30) / 2);
      const marginY = Math.round((sheetCanvas.height - rows * (photoH + 30) + 30) / 2);

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = marginX + c * (photoW + 30);
          const y = marginY + r * (photoH + 30);

          sCtx.drawImage(singlePhotoCanvas, x, y, photoW, photoH);

          sCtx.strokeStyle = '#d4d4d8';
          sCtx.lineWidth = 1;
          sCtx.strokeRect(x - 1, y - 1, photoW + 2, photoH + 2);
        }
      }

      sheetCanvas.toBlob(function(sheetBlob) {
        if (!sheetBlob) return;
        if (sheetBlobUrl) URL.revokeObjectURL(sheetBlobUrl);
        sheetBlobUrl = URL.createObjectURL(sheetBlob);
        btnDownloadSheet.href = sheetBlobUrl;
      }, 'image/jpeg', 0.95);
    }
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initImageTool);
    } else {
      initImageTool();
    }
    document.addEventListener('astro:page-load', initImageTool);
  }
</script>
