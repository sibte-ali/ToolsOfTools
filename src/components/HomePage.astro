---
import Layout from '../layouts/Layout.astro';
import { toolsByLang, foldersByLang } from '../lib/tools';
import { getTranslations, type SupportedLanguage } from '../i18n';
import { getCanonicalToolUrl } from '../lib/hreflang';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const tools = toolsByLang(lang);
const folders = foldersByLang(lang);

const titles: Record<SupportedLanguage, string> = {
  en: 'Tools of Tools - Fast, Client-Side Free Online Tools',
  'pt-br': 'Tools of Tools - Ferramentas e Calculadoras Online Gratuitas',
  es: 'Calculadora Online y Herramientas Gratuitas - Tools of Tools',
};

const headings: Record<SupportedLanguage, string> = {
  en: 'Fast, Client-Side Online Tools',
  'pt-br': 'Ferramentas e Calculadoras Rápidas',
  es: 'Calculadora Online y Herramientas',
};

const subheadings: Record<SupportedLanguage, string> = {
  en: 'Accurate, privacy-friendly calculators and utilities that run 100% in your browser without tracking.',
  'pt-br': 'Calculadoras e utilitários precisos e privados que rodam direto no seu navegador sem rastreamento.',
  es: 'Calculadoras y utilidades precisas y privadas que funcionan 100% en tu navegador.',
};

// If Spanish, find the calculadora tool mounted on home
const calculadoraTool = lang === 'es' ? tools.find((tool) => tool.slug === 'calculadora') : undefined;
---

<Layout title={titles[lang]} description={subheadings[lang]} lang={lang}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-neutral-950 dark:text-white">
        {headings[lang]}
      </h1>
      <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-300">
        {subheadings[lang]}
      </p>
    </div>

    {
      calculadoraTool && (
        <section class="mt-12 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900 max-w-xl mx-auto">
          <div class="mb-4 text-center">
            <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">Calculadora Básica y Científica</h2>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Cálculo rápido y seguro en tu navegador</p>
          </div>
          <div id="calculator-app" class="space-y-4">
            <div class="rounded-lg bg-neutral-100 p-4 text-right dark:bg-neutral-800 font-mono text-2xl font-bold border border-neutral-200 dark:border-neutral-700 min-h-16 flex items-center justify-end">
              <span id="calc-display">0</span>
            </div>
            <div class="grid grid-cols-4 gap-2">
              <button type="button" class="calc-btn p-3 bg-neutral-200 dark:bg-neutral-700 rounded-lg font-semibold hover:bg-neutral-300 dark:hover:bg-neutral-600" data-val="C">C</button>
              <button type="button" class="calc-btn p-3 bg-neutral-200 dark:bg-neutral-700 rounded-lg font-semibold hover:bg-neutral-300 dark:hover:bg-neutral-600" data-val="(">(</button>
              <button type="button" class="calc-btn p-3 bg-neutral-200 dark:bg-neutral-700 rounded-lg font-semibold hover:bg-neutral-300 dark:hover:bg-neutral-600" data-val=")">)</button>
              <button type="button" class="calc-btn p-3 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 rounded-lg font-semibold" data-val="/">÷</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="7">7</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="8">8</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="9">9</button>
              <button type="button" class="calc-btn p-3 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 rounded-lg font-semibold" data-val="*">×</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="4">4</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="5">5</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="6">6</button>
              <button type="button" class="calc-btn p-3 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 rounded-lg font-semibold" data-val="-">-</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="1">1</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="2">2</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val="3">3</button>
              <button type="button" class="calc-btn p-3 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 rounded-lg font-semibold" data-val="+">+</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold col-span-2" data-val="0">0</button>
              <button type="button" class="calc-btn p-3 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg font-semibold" data-val=".">.</button>
              <button type="button" class="calc-btn p-3 bg-emerald-600 text-white rounded-lg font-semibold hover:bg-emerald-700" data-val="=">=</button>
            </div>
          </div>
          <script>
            let currentExpr = '0';
            const display = document.getElementById('calc-display');
            document.querySelectorAll('.calc-btn').forEach((btn) => {
              btn.addEventListener('click', () => {
                const val = btn.getAttribute('data-val');
                if (val === 'C') {
                  currentExpr = '0';
                } else if (val === '=') {
                  try {
                    // Safe numeric evaluator without eval
                    const sanitized = currentExpr.replace(/[^0-9+\-*/().]/g, '');
                    currentExpr = String(Function(`'use strict'; return (${sanitized})`)());
                  } catch {
                    currentExpr = 'Error';
                  }
                } else {
                  if (currentExpr === '0' || currentExpr === 'Error') {
                    currentExpr = val || '';
                  } else {
                    currentExpr += val;
                  }
                }
                if (display) display.textContent = currentExpr;
              });
            });
          </script>
        </section>
      )
    }

    <!-- Categories / Folders Hub Links -->
    <section class="mt-16">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
        {t.nav.categories}
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          folders.map((folder) => {
            const folderPrefix = lang === 'en' ? `/${folder}/` : `/${lang}/${folder}/`;
            const count = tools.filter((t) => t.folder === folder).length;
            return (
              <a
                href={folderPrefix}
                class="group rounded-xl border border-neutral-200 bg-white p-5 shadow-xs transition hover:border-neutral-400 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700"
              >
                <h3 class="text-base font-semibold capitalize text-neutral-900 group-hover:text-neutral-950 dark:text-neutral-100">
                  {folder.replace(/-/g, ' ')}
                </h3>
                <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                  {count} {t.nav.tools.toLowerCase()}
                </p>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Available Tools Grid -->
    <section class="mt-16">
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
        {t.nav.tools}
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tools.map((tool) => {
            const canonicalUrl = getCanonicalToolUrl(tool);
            return (
              <a
                href={canonicalUrl}
                class="group flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-5 shadow-xs transition hover:border-neutral-400 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700"
              >
                <div>
                  <span class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                    {tool.folder}
                  </span>
                  <h3 class="mt-2 text-base font-semibold capitalize text-neutral-900 group-hover:text-neutral-950 dark:text-neutral-100">
                    {tool.keyword}
                  </h3>
                  <p class="mt-2 text-xs text-neutral-500 line-clamp-2 dark:text-neutral-400">
                    {tool.spec}
                  </p>
                </div>
                <div class="mt-4 flex items-center text-xs font-medium text-neutral-900 dark:text-white">
                  <span>Open tool &rarr;</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
