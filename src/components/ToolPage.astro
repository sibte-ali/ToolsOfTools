---
import Layout from '../layouts/Layout.astro';
import type { Tool } from '../lib/tools';
import { getTranslations, getHtmlLang, type SupportedLanguage, getLanguageHome } from '../i18n';
import { resolveToolLocale } from '../lib/format';
import {
  generateWebApplicationSchema,
  generateBreadcrumbSchema,
  generateFaqSchema,
} from '../lib/schema';

interface Props {
  lang: SupportedLanguage;
  tool: Tool;
  faq?: { q: string; a: string }[];
}

const { lang, tool, faq = [] } = Astro.props;
const t = getTranslations(lang);
const homeUrl = getLanguageHome(lang);
const folderUrl = lang === 'en' ? `/${tool.folder}/` : `/${lang}/${tool.folder}/`;

const siteUrl = Astro.site ? Astro.site.origin : 'https://toolsoftools.com';
const currentPath = Astro.url.pathname;
const canonical = `${siteUrl}${currentPath}`;

const localeConfig = resolveToolLocale(tool);

const pageTitle = `${tool.keyword.charAt(0).toUpperCase() + tool.keyword.slice(1)} - ToolsOfTools`;
const pageDescription = tool.spec
  ? `${tool.spec.slice(0, 150)}...`
  : `Free online ${tool.keyword} tool. Client-side, fast, and secure.`;

// Determine disclaimer text
let disclaimerText = '';
const isFinance =
  tool.folder.includes('finance') ||
  tool.folder.includes('financas') ||
  tool.risk_flags.toLowerCase().includes('money') ||
  tool.risk_flags.toLowerCase().includes('legal');

const isHealth =
  tool.folder.includes('health') ||
  tool.folder.includes('saude') ||
  tool.risk_flags.toLowerCase().includes('health');

if (isFinance) {
  disclaimerText = t.disclaimer.finance;
} else if (isHealth) {
  disclaimerText = t.disclaimer.health;
} else if (tool.template === 'fun') {
  disclaimerText = t.disclaimer.entertainment;
}

// Category mapping for WebApplication
let appCategory = 'UtilitiesApplication';
if (isFinance) appCategory = 'FinanceApplication';
else if (isHealth) appCategory = 'HealthApplication';

// JSON-LD structured data
const jsonLd: Record<string, any>[] = [
  generateWebApplicationSchema({
    name: tool.keyword,
    url: canonical,
    description: pageDescription,
    category: appCategory,
    operatingSystem: 'Any',
    inLanguage: getHtmlLang(lang),
    currency: localeConfig.currency,
  }),
  generateBreadcrumbSchema([
    { name: t.nav.home, url: `${siteUrl}${homeUrl}` },
    { name: tool.folder.replace(/-/g, ' '), url: `${siteUrl}${folderUrl}` },
    { name: tool.keyword, url: canonical },
  ]),
];

const faqSchema = generateFaqSchema(faq);
if (faqSchema) {
  jsonLd.push(faqSchema);
}

const methodologyUrl = lang === 'en' ? '/methodology/' : `/${lang}/methodology/`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main-content" class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumbs" class="mb-6 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
      <a href={homeUrl} class="hover:underline">{t.nav.home}</a>
      <span>/</span>
      <a href={folderUrl} class="capitalize hover:underline">{tool.folder.replace(/-/g, ' ')}</a>
      <span>/</span>
      <span class="capitalize text-neutral-900 dark:text-white font-medium">{tool.keyword}</span>
    </nav>

    <!-- Header -->
    <header class="border-b border-neutral-200 pb-6 dark:border-neutral-800">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-neutral-950 dark:text-white capitalize">
        {tool.keyword}
      </h1>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
        {tool.spec}
      </p>
    </header>

    <!-- Interactive Tool Container -->
    <section class="mt-8 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
      <div id="tool-container" class="space-y-6" data-locale={localeConfig.locale} data-currency={localeConfig.currency}>
        <div class="rounded-lg bg-neutral-50 p-6 border border-neutral-200 dark:bg-neutral-800/50 dark:border-neutral-700">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              Interactive Tool Workspace
            </span>
            <span class="rounded-md bg-neutral-200 px-2 py-0.5 text-xs font-mono dark:bg-neutral-700">
              Locale: {localeConfig.locale}
            </span>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <button
              type="button"
              id="calc-action"
              class="rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white shadow-xs hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100"
            >
              {t.calculate}
            </button>
            <button
              type="button"
              id="reset-action"
              class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800"
            >
              {t.reset}
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Information Sections -->
    <section class="mt-12 space-y-8 text-neutral-800 dark:text-neutral-200">
      <article>
        <h2 class="text-xl font-bold text-neutral-950 dark:text-white">
          {t.howItWorks}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
          {tool.spec}
        </p>

        {
          (isFinance || isHealth) && (
            <p class="mt-4 text-xs text-neutral-500 dark:text-neutral-400">
              <a href={methodologyUrl} class="font-medium underline hover:text-neutral-900 dark:hover:text-white">
                &rarr; {t.methodologyLinkText}
              </a>
            </p>
          )
        }
      </article>

      {
        disclaimerText && (
          <aside class="rounded-xl border-l-4 border-amber-500 bg-amber-50/70 p-4 text-xs leading-relaxed text-amber-900 dark:bg-amber-950/30 dark:text-amber-200">
            {disclaimerText}
          </aside>
        )
      }
    </section>
  </main>
</Layout>
