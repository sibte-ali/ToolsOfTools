---
import Layout from '../layouts/Layout.astro';
import type { Tool } from '../lib/tools';
import { getTranslations, type SupportedLanguage, getLanguageHome } from '../i18n';
import { generateBreadcrumbSchema } from '../lib/schema';
import { getEntry, render } from 'astro:content';

interface Props {
  lang: SupportedLanguage;
  folder: string;
  tools: Tool[];
}

const { lang, folder, tools } = Astro.props;
const t = getTranslations(lang);
const homeUrl = getLanguageHome(lang);
const folderTitle = folder.replace(/-/g, ' ');

const siteUrl = Astro.site ? Astro.site.origin : 'https://toolsoftools.com';
const currentPath = Astro.url.pathname;
const canonical = `${siteUrl}${currentPath}`;

// Load native copy from src/content/hubs/<lang>/<folder>.md
const hubEntry = await getEntry('hubs', `${lang}/${folder}`);
const rendered = hubEntry ? await render(hubEntry) : null;
const HubContent = rendered?.Content;

const h1 = hubEntry?.data.title || folderTitle.charAt(0).toUpperCase() + folderTitle.slice(1);
const pageTitle = `${h1} - ToolsOfTools`;
const pageDescription = hubEntry?.data.description || `Explore our comprehensive collection of free online tools and calculators in the ${folderTitle} category. Fast, private, and client-side.`;

// Sort tools by search volume descending
const sortedTools = [...tools].sort((a, b) => (b.volume || 0) - (a.volume || 0));

// BreadcrumbList JSON-LD
const jsonLd = [
  generateBreadcrumbSchema([
    { name: t.nav.home, url: `${siteUrl}${homeUrl}` },
    { name: h1, url: canonical },
  ]),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main-content" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumbs" class="mb-8 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
      <a href={homeUrl} class="hover:underline text-neutral-600 dark:text-neutral-400">{t.nav.home}</a>
      <span>/</span>
      <span class="capitalize text-neutral-900 dark:text-white font-medium">{h1}</span>
    </nav>

    <header class="max-w-4xl border-b border-neutral-200 pb-8 dark:border-neutral-800">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-[#0D47A1] dark:text-white capitalize">
        {h1}
      </h1>
      <div class="mt-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#E3F2FD] text-[#0D47A1] border border-[#90CAF9]/60 dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700">
          {t.toolsAvailable(sortedTools.length)}
        </span>
      </div>

      <!-- Short intro: 150-250 words native copy from src/content/hubs/<lang>/<folder>.md -->
      <div class="mt-6 space-y-4 text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
        {HubContent ? (
          <HubContent />
        ) : (
          <p>{pageDescription}</p>
        )}
      </div>
    </header>

    <!-- Grid of every tool in the folder with one-line descriptions, sorted by volume -->
    <section aria-label="Tools directory" class="mt-10">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          sortedTools.map((tool) => {
            return (
              <a
                href={tool.url}
                class="group flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-5 shadow-xs transition hover:border-[#90CAF9] hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700"
              >
                <div>
                  <h2 class="text-base font-semibold capitalize text-[#0D47A1] group-hover:text-[#2196F3] dark:text-neutral-100 dark:group-hover:text-white transition-colors">
                    {tool.keyword}
                  </h2>
                  <p class="mt-2 text-xs leading-relaxed text-neutral-600 line-clamp-3 dark:text-neutral-400">
                    {tool.spec}
                  </p>
                </div>
                <div class="mt-5 flex items-center text-xs font-semibold text-[#1976D2] dark:text-sky-400">
                  <span>{t.openTool}</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
