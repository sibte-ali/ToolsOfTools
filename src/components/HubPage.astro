---
import Layout from '../layouts/Layout.astro';
import type { Tool } from '../lib/tools';
import { getTranslations, type SupportedLanguage, getLanguageHome } from '../i18n';
import { getCanonicalToolUrl } from '../lib/hreflang';

interface Props {
  lang: SupportedLanguage;
  folder: string;
  tools: Tool[];
}

const { lang, folder, tools } = Astro.props;
const t = getTranslations(lang);
const homeUrl = getLanguageHome(lang);
const folderTitle = folder.replace(/-/g, ' ');

const pageTitle = `${folderTitle.charAt(0).toUpperCase() + folderTitle.slice(1)} Tools - ToolsOfTools`;
const pageDescription = `Explore all free, client-side tools and calculators in the ${folderTitle} category.`;
---

<Layout title={pageTitle} description={pageDescription} lang={lang}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-8 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
      <a href={homeUrl} class="hover:underline">{t.nav.home}</a>
      <span>/</span>
      <span class="capitalize text-neutral-900 dark:text-white font-medium">{folderTitle}</span>
    </nav>

    <div class="max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-neutral-950 dark:text-white capitalize">
        {folderTitle}
      </h1>
      <p class="mt-3 text-base text-neutral-600 dark:text-neutral-300">
        {tools.length} {t.nav.tools.toLowerCase()}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => {
          const canonicalUrl = getCanonicalToolUrl(tool);
          return (
            <a
              href={canonicalUrl}
              class="group flex flex-col justify-between rounded-xl border border-neutral-200 bg-white p-5 shadow-xs transition hover:border-neutral-400 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700"
            >
              <div>
                <h2 class="text-base font-semibold capitalize text-neutral-900 group-hover:text-neutral-950 dark:text-neutral-100">
                  {tool.keyword}
                </h2>
                <p class="mt-2 text-xs text-neutral-500 line-clamp-3 dark:text-neutral-400">
                  {tool.spec}
                </p>
              </div>
              <div class="mt-4 flex items-center text-xs font-medium text-neutral-900 dark:text-white">
                <span>Open &rarr;</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </main>
</Layout>
