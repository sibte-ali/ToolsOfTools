  </div>
</header>

<!-- Header Client Interaction Script -->
<script is:inline>
  function initHeaderNavigation() {
    // 1. Reactive Categories Hover Panel Switching
    const catItems = document.querySelectorAll('.nav-cat-item');
    const catPanels = document.querySelectorAll('.nav-cat-panel');

    catItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        const targetIdx = item.getAttribute('data-cat-index');

        // Update active class on left list
        catItems.forEach((other) => {
          other.classList.remove(
            'bg-white',
            'shadow-xs',
            'text-neutral-950',
            'font-bold',
            'dark:bg-neutral-800',
            'dark:text-white'
          );
          other.classList.add('text-neutral-600', 'dark:text-neutral-300');
        });
        item.classList.add(
          'bg-white',
          'shadow-xs',
          'text-neutral-950',
          'font-bold',
          'dark:bg-neutral-800',
          'dark:text-white'
        );
        item.classList.remove('text-neutral-600', 'dark:text-neutral-300');

        // Show matching tool panel on the right
        catPanels.forEach((panel) => {
          panel.classList.add('hidden');
          panel.classList.remove('block');
        });

        const activePanel = document.getElementById('nav-cat-panel-' + targetIdx);
        if (activePanel) {
          activePanel.classList.remove('hidden');
          activePanel.classList.add('block');
        }
      });
    });

    // 2. Mobile Menu Toggle
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        const isClosed = mobileMenu.classList.contains('hidden');
        if (isClosed) {
          mobileMenu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          mobileToggle.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 3. Mobile Accordion Toggles
    const accordionToggles = document.querySelectorAll('.mobile-accordion-toggle');
    accordionToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        const icon = btn.querySelector('svg');
        if (targetEl) {
          const isHidden = targetEl.classList.contains('hidden');
          if (isHidden) {
            targetEl.classList.remove('hidden');
            if (icon) icon.classList.add('rotate-180');
          } else {
            targetEl.classList.add('hidden');
            if (icon) icon.classList.remove('rotate-180');
          }
        }
      });
    });

    // 4. Dark/Light Theme Toggle
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('tot-theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    }

    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.onclick = toggleTheme;
    }
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
    if (mobileThemeBtn) {
      mobileThemeBtn.onclick = toggleTheme;
    }
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderNavigation);
    } else {
      initHeaderNavigation();
    }
    document.addEventListener('astro:page-load', initHeaderNavigation);
  }
</script>
