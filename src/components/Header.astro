---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLanguageHome, getTranslations, type SupportedLanguage, supportedLanguages } from '../i18n';
import { getEffectiveHubs, toolsByLang, type Tool, type EffectiveHub } from '../lib/tools';

interface Props {
  currentUrl?: string;
  lang?: string;
}

const { currentUrl = '/', lang = 'en' } = Astro.props;
const supportedLang = (supportedLanguages.includes(lang as SupportedLanguage) ? lang : 'en') as SupportedLanguage;
const homeUrl = getLanguageHome(supportedLang);
const t = getTranslations(supportedLang);
const hubs: EffectiveHub[] = getEffectiveHubs(supportedLang);
const allTools: Tool[] = toolsByLang(supportedLang).length > 0 ? toolsByLang(supportedLang) : toolsByLang('en');

function getCategoryIcon(folder: string): string {
  switch (folder) {
    case 'finance':
    case 'financas':
      return '💰';
    case 'image-tools':
      return '🖼️';
    case 'education':
      return '🎓';
    case 'health':
    case 'saude':
      return '🏃';
    case 'date-time':
    case 'datas-e-tempo':
      return '⏱️';
    case 'engineering':
      return '⚙️';
    case 'converters':
      return '🔄';
    case 'astrology':
      return '🔮';
    case 'font-converters':
      return '🔤';
    case 'math':
    case 'matematica':
      return '➗';
    case 'developer-tools':
      return '⚡';
    case 'json':
      return '🗂️';
    default:
      return '🛠️';
  }
}

function formatCategoryName(name: string, folder: string): string {
  if (folder === 'image-tools') return 'Image Tools';
  if (folder === 'date-time') return 'Date & Time';
  if (folder === 'font-converters') return 'Font Converters';
  if (folder === 'other-calculators') return 'Other Utilities';
  if (folder === 'outras-calculadoras') return 'Outras Ferramentas';
  if (folder === 'otras-calculadoras') return 'Otras Herramientas';
  if (folder === 'developer-tools') return 'Developer Tools';
  if (folder === 'json') return 'JSON Tools';
  return name.replace(/\b\w/g, (l) => l.toUpperCase());
}

function getCategoryUrl(folder: string, currentLang: string): string {
  if (currentLang === 'es' || currentLang === 'pt-br') return `/${currentLang}/${folder}/`;
  return `/${folder}/`;
}

function getToolUrl(tool: Tool, currentLang: string): string {
  if (currentLang === 'en') return tool.url;
  if (tool.url.startsWith(`/${currentLang}/`)) return tool.url;
  return `/${currentLang}${tool.url.startsWith('/') ? tool.url : '/' + tool.url}`;
}

// Popular / Trending tools
const popularTools = [...allTools].sort((a, b) => (b.volume || 0) - (a.volume || 0)).slice(0, 8);
---

<header class="border-b border-neutral-200 bg-white/90 backdrop-blur-md sticky top-0 z-50 dark:border-neutral-800 dark:bg-neutral-900/90 transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    
    <!-- Left: Brand Logo & Navigation Links -->
    <div class="flex items-center gap-8">
      <a href={homeUrl} class="flex items-center gap-2 text-xl font-bold tracking-tight text-neutral-950 dark:text-white group">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-extrabold text-sm transition group-hover:scale-105 shadow-2xs">
          ToT
        </span>
        <span class="tracking-tight">ToolsOfTools</span>
      </a>

      <!-- Desktop Navigation with Hover Dropdowns -->
      <nav class="hidden md:flex items-center gap-2" aria-label="Main Navigation">
        
        <!-- 1. CATEGORIES Dropdown (Category-Level Navigation Only) -->
        <div class="relative group/categories" id="nav-categories-wrapper">
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>{t.nav.categories}</span>
            <svg class="h-3.5 w-3.5 text-neutral-400 group-hover/categories:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Container with Category Links Only -->
          <div class="absolute -left-4 top-full pt-2 opacity-0 invisible group-hover/categories:opacity-100 group-hover/categories:visible transition-all duration-200 ease-out z-50 pointer-events-none group-hover/categories:pointer-events-auto">
            <div class="w-[520px] max-w-[90vw] rounded-2xl border border-neutral-200/90 bg-white/95 backdrop-blur-2xl p-4 shadow-2xl dark:border-neutral-800 dark:bg-neutral-900/95">
              <div class="px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 border-b border-neutral-100 dark:border-neutral-800 pb-2 mb-2 flex items-center justify-between">
                <span>Browse Categories</span>
                <span>{hubs.length} Hubs</span>
              </div>
              <div class="grid grid-cols-2 gap-1.5">
                {
                  hubs.map((hub) => {
                    const catUrl = getCategoryUrl(hub.folder, supportedLang);
                    return (
                      <a
                        href={catUrl}
                        class="group/item flex items-center justify-between gap-2.5 rounded-xl px-3 py-2.5 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
                      >
                        <div class="flex items-center gap-2.5 truncate">
                          <span class="text-base shrink-0">{getCategoryIcon(hub.folder)}</span>
                          <span class="truncate">{formatCategoryName(hub.name, hub.folder)}</span>
                        </div>
                        <span class="rounded-md bg-neutral-200/80 px-1.5 py-0.5 text-[10px] font-mono font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300 shrink-0">
                          {hub.tools.length}
                        </span>
                      </a>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>

        <!-- 2. DIRECTORY Link (Clean navigation without tool link dumps) -->
        <a
          href={`${homeUrl}#tools-directory`}
          class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>{t.nav.tools}</span>
        </a>

      </nav>
    </div>

    <!-- Right: Theme Toggle, Language Switcher & Mobile Menu Trigger -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-white transition cursor-pointer shadow-xs"
        aria-label="Toggle dark and light theme"
        title="Toggle dark / light theme"
      >
        <!-- Sun icon shown in dark mode -->
        <svg class="hidden dark:block h-4.5 w-4.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon shown in light mode -->
        <svg class="block dark:hidden h-4.5 w-4.5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <LanguageSwitcher currentUrl={currentUrl} currentLang={supportedLang} />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-750 transition cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-menu-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer / Accordion Menu -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900 px-4 py-4 space-y-4 max-h-[80vh] overflow-y-auto">
    
    <!-- Mobile Categories List (Category-Level Navigation Only) -->
    <div>
      <div class="py-2 text-xs font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
        <span>{t.nav.categories}</span>
      </div>
      <div class="space-y-1.5">
        {hubs.map((hub) => (
          <a
            href={getCategoryUrl(hub.folder, supportedLang)}
            class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
          >
            <span class="flex items-center gap-2">
              <span>{getCategoryIcon(hub.folder)}</span>
              <span>{formatCategoryName(hub.name, hub.folder)}</span>
            </span>
            <span class="rounded-md bg-neutral-200/80 px-1.5 py-0.5 text-[10px] font-mono font-medium text-neutral-600 dark:bg-neutral-700 dark:text-neutral-300">
              {hub.tools.length}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Directory Link -->
    <div class="pt-2 border-t border-neutral-200 dark:border-neutral-800">
      <a
        href={`${homeUrl}#tools-directory`}
        class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold text-neutral-800 bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition"
      >
        <span class="flex items-center gap-2">
          <span>🛠️</span>
          <span>View All Tools</span>
        </span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Mobile Theme Toggle -->
    <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Theme</span>
      <button
        type="button"
        id="mobile-theme-toggle-btn"
        class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-neutral-300 bg-neutral-50 text-xs font-semibold text-neutral-800 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition cursor-pointer shadow-xs"
        aria-label="Toggle dark/light theme"
      >
        <span class="flex items-center gap-1.5 dark:hidden">
          <svg class="h-3.5 w-3.5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span>Light Mode</span>
        </span>
        <span class="hidden items-center gap-1.5 dark:flex">
          <svg class="h-3.5 w-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Dark Mode</span>
        </span>
      </button>
    </div>

  </div>
</header>

<!-- Header Client Interaction Script -->
<script is:inline>
  function initHeaderNavigation() {
    // 1. Mobile Menu Toggle
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-nav-menu');
    const iconOpen = document.getElementById('icon-menu-open');
    const iconClose = document.getElementById('icon-menu-close');

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        const isClosed = mobileMenu.classList.contains('hidden');
        if (isClosed) {
          mobileMenu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          mobileToggle.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // 3. Mobile Accordion Toggles
    const accordionToggles = document.querySelectorAll('.mobile-accordion-toggle');
    accordionToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        const icon = btn.querySelector('svg');
        if (targetEl) {
          const isHidden = targetEl.classList.contains('hidden');
          if (isHidden) {
            targetEl.classList.remove('hidden');
            if (icon) icon.classList.add('rotate-180');
          } else {
            targetEl.classList.add('hidden');
            if (icon) icon.classList.remove('rotate-180');
          }
        }
      });
    });

    // 4. Dark/Light Theme Toggle
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('tot-theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    }

    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      themeBtn.onclick = toggleTheme;
    }
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
    if (mobileThemeBtn) {
      mobileThemeBtn.onclick = toggleTheme;
    }
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderNavigation);
    } else {
      initHeaderNavigation();
    }
    document.addEventListener('astro:page-load', initHeaderNavigation);
  }
</script>
