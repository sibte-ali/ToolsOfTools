---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLanguageHome } from '../i18n';

interface Props {
  currentUrl?: string;
  lang?: string;
}

const { currentUrl = '/', lang = 'en' } = Astro.props;
const homeUrl = getLanguageHome(lang);
---

<header class="border-b border-neutral-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 dark:border-neutral-800 dark:bg-neutral-900/80">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href={homeUrl} class="flex items-center gap-2 text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-extrabold text-sm">
          ToT
        </span>
        <span>ToolsOfTools</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <LanguageSwitcher currentUrl={currentUrl} currentLang={lang} />
    </div>
  </div>
</header>
