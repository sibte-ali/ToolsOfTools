---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLanguageHome, getTranslations, type SupportedLanguage, supportedLanguages } from '../i18n';
import { getEffectiveHubs, toolsByLang, type Tool, type EffectiveHub } from '../lib/tools';

interface Props {
  currentUrl?: string;
  lang?: string;
}

const { currentUrl = '/', lang = 'en' } = Astro.props;
const supportedLang = (supportedLanguages.includes(lang as SupportedLanguage) ? lang : 'en') as SupportedLanguage;
const homeUrl = getLanguageHome(supportedLang);
const t = getTranslations(supportedLang);
const hubs: EffectiveHub[] = getEffectiveHubs(supportedLang);
const allTools: Tool[] = toolsByLang(supportedLang).length > 0 ? toolsByLang(supportedLang) : toolsByLang('en');

function getCategoryIcon(folder: string): string {
  switch (folder) {
    case 'finance':
    case 'financas':
      return '💰';
    case 'image-tools':
      return '🖼️';
    case 'education':
      return '🎓';
    case 'health':
    case 'saude':
      return '🏃';
    case 'date-time':
    case 'datas-e-tempo':
      return '⏱️';
    case 'engineering':
      return '⚙️';
    case 'converters':
      return '🔄';
    case 'astrology':
      return '🔮';
    case 'font-converters':
      return '🔤';
    case 'math':
    case 'matematica':
      return '➗';
    case 'developer-tools':
      return '⚡';
    case 'json':
      return '🗂️';
    default:
      return '🛠️';
  }
}

function formatCategoryName(name: string, folder: string): string {
  if (folder === 'image-tools') return 'Image Tools';
  if (folder === 'date-time') return 'Date & Time';
  if (folder === 'font-converters') return 'Font Converters';
  if (folder === 'other-calculators') return 'Other Utilities';
  if (folder === 'outras-calculadoras') return 'Outras Ferramentas';
  if (folder === 'otras-calculadoras') return 'Otras Herramientas';
  if (folder === 'developer-tools') return 'Developer Tools';
  if (folder === 'json') return 'JSON Tools';
  return name.replace(/\b\w/g, (l) => l.toUpperCase());
}

function getCategoryUrl(folder: string, currentLang: string): string {
  if (currentLang === 'es' || currentLang === 'pt-br') return `/${currentLang}/${folder}/`;
  return `/${folder}/`;
}

function getToolUrl(tool: Tool, currentLang: string): string {
  if (currentLang === 'en') return tool.url;
  if (tool.url.startsWith(`/${currentLang}/`)) return tool.url;
  return `/${currentLang}${tool.url.startsWith('/') ? tool.url : '/' + tool.url}`;
}

// Popular / Trending tools
const popularTools = [...allTools].sort((a, b) => (b.volume || 0) - (a.volume || 0)).slice(0, 8);
---

<header class="border-b border-neutral-200 bg-white/90 backdrop-blur-md sticky top-0 z-50 dark:border-neutral-800 dark:bg-neutral-900/90 transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    
    <!-- Left: Brand Logo & Navigation Links -->
    <div class="flex items-center gap-8">
      <a href={homeUrl} class="flex items-center gap-2 text-xl font-bold tracking-tight text-neutral-950 dark:text-white group">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-extrabold text-sm transition group-hover:scale-105 shadow-2xs">
          ToT
        </span>
        <span class="tracking-tight">ToolsOfTools</span>
      </a>

      <!-- Desktop Navigation with Hover Dropdowns -->
      <nav class="hidden md:flex items-center gap-1.5" aria-label="Main Navigation">
        
        <!-- 1. CATEGORIES Dropdown (Multi-Level / Hover Split-Pane) -->
        <div class="relative group/categories" id="nav-categories-wrapper">
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>{t.nav.categories}</span>
            <svg class="h-3.5 w-3.5 text-neutral-400 group-hover/categories:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Container with Hover Bridge -->
          <div class="absolute -left-4 top-full pt-2 opacity-0 invisible group-hover/categories:opacity-100 group-hover/categories:visible transition-all duration-200 ease-out z-50 pointer-events-none group-hover/categories:pointer-events-auto">
            <div class="flex w-[760px] max-w-[90vw] rounded-2xl border border-neutral-200/90 bg-white/95 backdrop-blur-2xl shadow-2xl dark:border-neutral-800 dark:bg-neutral-900/95 overflow-hidden">
              
              <!-- Left: Categories List with Hover Event Targets -->
              <div class="w-64 border-r border-neutral-200/80 bg-neutral-50/70 p-3 dark:border-neutral-800 dark:bg-neutral-950/50 space-y-1 overflow-y-auto max-h-[480px]">
                <div class="px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                  Select Category
                </div>
                {
                  hubs.map((hub, index) => {
                    const catUrl = getCategoryUrl(hub.folder, supportedLang);
                    return (
                      <a
                        href={catUrl}
                        class={`nav-cat-item group/item flex items-center justify-between gap-2.5 rounded-xl px-3 py-2 text-xs font-semibold transition cursor-pointer ${
                          index === 0
                            ? 'bg-white shadow-xs text-neutral-950 font-bold dark:bg-neutral-800 dark:text-white'
                            : 'text-neutral-600 hover:bg-white hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white'
                        }`}
                        data-cat-index={index}
                      >
                        <div class="flex items-center gap-2.5 truncate">
                          <span class="text-base shrink-0">{getCategoryIcon(hub.folder)}</span>
                          <span class="truncate">{formatCategoryName(hub.name, hub.folder)}</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-neutral-400 dark:text-neutral-500 shrink-0">
                          <span class="rounded-md bg-neutral-200/80 px-1.5 py-0.5 text-[10px] font-mono font-medium text-neutral-700 dark:bg-neutral-700 dark:text-neutral-200">
                            {hub.tools.length}
                          </span>
                          <svg class="h-3 w-3 transition-transform group-hover/item:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                          </svg>
                        </div>
                      </a>
                    );
                  })
                }
              </div>

              <!-- Right: Reactive Tools List for Active/Hovered Category -->
              <div class="flex-1 p-5 overflow-y-auto max-h-[480px]">
                {
                  hubs.map((hub, index) => {
                    const catUrl = getCategoryUrl(hub.folder, supportedLang);
                    return (
                      <div
                        id={`nav-cat-panel-${index}`}
                        class={`nav-cat-panel ${index === 0 ? 'block' : 'hidden'} space-y-4`}
                      >
                        <!-- Panel Header -->
                        <div class="flex items-center justify-between border-b border-neutral-100 pb-3 dark:border-neutral-800">
                          <div class="flex items-center gap-2.5">
                            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-neutral-100 text-lg dark:bg-neutral-800 shadow-2xs">
                              {getCategoryIcon(hub.folder)}
                            </span>
                            <div>
                              <h4 class="text-sm font-bold text-neutral-900 dark:text-white capitalize">
                                {formatCategoryName(hub.name, hub.folder)}
                              </h4>
                              <p class="text-[11px] text-neutral-500 dark:text-neutral-400">
                                {hub.tools.length} verified calculators and utilities
                              </p>
                            </div>
                          </div>
                          <a
                            href={catUrl}
                            class="inline-flex items-center gap-1 rounded-lg border border-neutral-200 bg-white px-2.5 py-1 text-xs font-semibold text-neutral-800 shadow-2xs hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition"
                          >
                            <span>Browse Hub</span>
                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                          </a>
                        </div>

                        <!-- 2-Column Grid of Tools for Hovered Category -->
                        <div class="grid grid-cols-2 gap-2">
                          {hub.tools.map((tool) => (
                            <a
                              href={getToolUrl(tool, supportedLang)}
                              class="group/tool flex flex-col justify-center rounded-xl border border-transparent p-2.5 hover:border-neutral-200 hover:bg-neutral-50 hover:shadow-2xs dark:hover:border-neutral-800 dark:hover:bg-neutral-800/80 transition"
                            >
                              <span class="text-xs font-bold text-neutral-800 group-hover/tool:text-neutral-950 dark:text-neutral-200 dark:group-hover/tool:text-white capitalize truncate">
                                {tool.keyword}
                              </span>
                              <span class="mt-0.5 text-[10px] font-mono text-neutral-400 dark:text-neutral-500 truncate">
                                {tool.url}
                              </span>
                            </a>
                          ))}
                        </div>
                      </div>
                    );
                  })
                }
              </div>

            </div>
          </div>
        </div>

        <!-- 2. TOOLS Dropdown (Multi-Category Mega-Menu of Tools) -->
        <div class="relative group/tools" id="nav-tools-wrapper">
          <button
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{t.nav.tools}</span>
            <svg class="h-3.5 w-3.5 text-neutral-400 group-hover/tools:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Container with Hover Bridge -->
          <div class="absolute -left-36 top-full pt-2 opacity-0 invisible group-hover/tools:opacity-100 group-hover/tools:visible transition-all duration-200 ease-out z-50 pointer-events-none group-hover/tools:pointer-events-auto">
            <div class="w-[820px] max-w-[92vw] rounded-2xl border border-neutral-200/90 bg-white/95 backdrop-blur-2xl p-6 shadow-2xl dark:border-neutral-800 dark:bg-neutral-900/95">
              
              <!-- Header Bar -->
              <div class="flex items-center justify-between border-b border-neutral-200/80 pb-4 dark:border-neutral-800">
                <div>
                  <h3 class="text-sm font-extrabold text-neutral-900 dark:text-white flex items-center gap-2">
                    <span>{t.nav.tools}</span>
                    <span class="rounded-full bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 text-[10px] px-2 py-0.5 font-bold">
                      {allTools.length} Tools
                    </span>
                  </h3>
                  <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
                    100% private, client-side online calculators and utilities
                  </p>
                </div>
                <a
                  href={`${homeUrl}#tools-directory`}
                  class="text-xs font-semibold text-neutral-900 dark:text-white hover:underline inline-flex items-center gap-1"
                >
                  <span>View Full Directory</span>
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>

              <!-- Multi-Column Grid of Top Tools -->
              <div class="mt-5 grid grid-cols-3 gap-6">
                <!-- Column 1: Most Popular Tools -->
                <div>
                  <div class="flex items-center gap-1.5 text-xs font-bold text-neutral-900 dark:text-white mb-2.5">
                    <span>🔥</span>
                    <span>Most Popular</span>
                  </div>
                  <ul class="space-y-1.5">
                    {popularTools.slice(0, 6).map((tool) => (
                      <li>
                        <a
                          href={getToolUrl(tool, supportedLang)}
                          class="group flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
                        >
                          <span class="capitalize truncate">{tool.keyword}</span>
                          <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 2: Image & Media Tools -->
                <div>
                  <div class="flex items-center gap-1.5 text-xs font-bold text-neutral-900 dark:text-white mb-2.5">
                    <span>🖼️</span>
                    <span>Image & Media</span>
                  </div>
                  <ul class="space-y-1.5">
                    {
                      allTools
                        .filter((t) => t.folder === 'image-tools')
                        .slice(0, 6)
                        .map((tool) => (
                          <li>
                            <a
                              href={getToolUrl(tool, supportedLang)}
                              class="group flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
                            >
                              <span class="capitalize truncate">{tool.keyword}</span>
                              <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                            </a>
                          </li>
                        ))
                    }
                  </ul>
                </div>

                <!-- Column 3: Finance & Mathematics -->
                <div>
                  <div class="flex items-center gap-1.5 text-xs font-bold text-neutral-900 dark:text-white mb-2.5">
                    <span>💰</span>
                    <span>Finance & Loans</span>
                  </div>
                  <ul class="space-y-1.5">
                    {
                      allTools
                        .filter((t) => t.folder === 'finance' || t.folder === 'financas')
                        .slice(0, 6)
                        .map((tool) => (
                          <li>
                            <a
                              href={getToolUrl(tool, supportedLang)}
                              class="group flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-neutral-700 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white transition"
                            >
                              <span class="capitalize truncate">{tool.keyword}</span>
                              <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                            </a>
                          </li>
                        ))
                    }
                  </ul>
                </div>
              </div>

              <!-- Bottom Quick Action Banner -->
              <div class="mt-5 pt-3 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400">
                <span>Looking for academic, health, or unit converters?</span>
                <a href={homeUrl} class="font-semibold text-neutral-900 dark:text-white hover:underline inline-flex items-center gap-1">
                  <span>Search all {allTools.length} tools &rarr;</span>
                </a>
              </div>

            </div>
          </div>
        </div>

      </nav>
    </div>

    <!-- Right: Theme Toggle, Language Switcher & Mobile Menu Trigger -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Toggle Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-white transition cursor-pointer shadow-xs"
        aria-label="Toggle dark and light theme"
        title="Toggle dark / light theme"
      >
        <!-- Sun icon shown in dark mode -->
        <svg class="hidden dark:block h-4.5 w-4.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon shown in light mode -->
        <svg class="block dark:hidden h-4.5 w-4.5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <LanguageSwitcher currentUrl={currentUrl} currentLang={supportedLang} />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-neutral-300 bg-white text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-750 transition cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-menu-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer / Accordion Menu -->
  <div id="mobile-nav-menu" class="hidden md:hidden border-t border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900 px-4 py-4 space-y-4 max-h-[80vh] overflow-y-auto">
    
    <!-- Mobile Categories Accordion -->
    <div>
      <button
        type="button"
        class="mobile-accordion-toggle flex w-full items-center justify-between py-2 text-sm font-bold text-neutral-900 dark:text-white"
        data-target="mobile-categories-list"
      >
        <span class="flex items-center gap-2">
          <span>📁</span>
          <span>{t.nav.categories}</span>
        </span>
        <svg class="h-4 w-4 text-neutral-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="mobile-categories-list" class="hidden pl-4 pr-1 py-2 space-y-3">
        {hubs.map((hub) => (
          <div class="space-y-1">
            <a
              href={getCategoryUrl(hub.folder, supportedLang)}
              class="flex items-center justify-between text-xs font-bold text-neutral-900 dark:text-white hover:underline"
            >
              <span>{getCategoryIcon(hub.folder)} {formatCategoryName(hub.name, hub.folder)}</span>
              <span class="text-[10px] text-neutral-400">({hub.tools.length})</span>
            </a>
            <div class="grid grid-cols-1 gap-1 pl-2">
              {hub.tools.slice(0, 4).map((tool) => (
                <a href={getToolUrl(tool, supportedLang)} class="text-[11px] text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white truncate">
                  &bull; {tool.keyword}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile Top Tools Accordion -->
    <div>
      <button
        type="button"
        class="mobile-accordion-toggle flex w-full items-center justify-between py-2 text-sm font-bold text-neutral-900 dark:text-white"
        data-target="mobile-tools-list"
      >
        <span class="flex items-center gap-2">
          <span>🛠️</span>
          <span>{t.nav.tools}</span>
        </span>
        <svg class="h-4 w-4 text-neutral-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="mobile-tools-list" class="hidden pl-4 pr-1 py-2 grid grid-cols-1 gap-2">
        {popularTools.map((tool) => (
          <a href={getToolUrl(tool, supportedLang)} class="text-xs text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white capitalize">
            &bull; {tool.keyword}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile Theme Toggle -->
    <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Theme</span>
      <button
        type="button"
        id="mobile-theme-toggle-btn"
        class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-neutral-300 bg-neutral-50 text-xs font-semibold text-neutral-800 hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-750 transition cursor-pointer shadow-xs"
        aria-label="Toggle dark/light theme"
      >
        <span class="flex items-center gap-1.5 dark:hidden">
          <svg class="h-3.5 w-3.5 text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span>Light Mode</span>
        </span>
        <span class="hidden items-center gap-1.5 dark:flex">
          <svg class="h-3.5 w-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
